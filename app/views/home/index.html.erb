<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-100">Home</h1>
  <p class="text-slate-400 mt-1">Requests needing your attention across all projects</p>
</div>

<%# Project carousel selector %>
<%= render "shared/project_carousel", projects: @projects %>

<%# Cross-project requests table %>
<h2 class="text-lg font-semibold text-slate-100 mb-4">Needs my action</h2>

<% if @requests.empty? %>
  <div class="text-center py-12 bg-slate-800 rounded-lg border border-slate-700">
    <svg class="mx-auto h-12 w-12 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3 class="mt-2 text-sm font-semibold text-slate-100">All caught up!</h3>
    <p class="mt-1 text-sm text-slate-400">No requests need your attention right now.</p>
  </div>
<% else %>
  <div class="bg-slate-800 rounded-lg border border-slate-700 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-slate-700">
      <thead class="bg-slate-800/50">
        <tr>
          <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Request
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Project
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Type
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Date Requested
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Stage
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Agent Status
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Pending
          </th>
          <th scope="col" class="relative py-3 pl-3 pr-4">
            <span class="sr-only">View</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-700/50 bg-slate-800">
        <% @requests.each do |request| %>
          <%= render "requests/request_row", request: request, show_project: true %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
