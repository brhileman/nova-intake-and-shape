<%#
  Group Dropdown for assigning requests to groups
  Locals: request, project (optional - defaults to request.project)
%>
<%
  request = local_assigns[:request]
  project = local_assigns[:project] || request.project
  groups = project.request_groups.order(:name)
  current_group = request.request_group
%>

<div class="relative" data-controller="dropdown">
  <button type="button"
          data-action="click->dropdown#toggle"
          class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium transition-colors
                 <%= current_group ? 'bg-purple-900/50 text-purple-300 hover:bg-purple-900/70' : 'bg-slate-700 text-slate-400 hover:bg-slate-600' %>">
    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
    </svg>
    <%= current_group ? current_group.name.truncate(15) : "No Group" %>
    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute z-50 mt-1 w-48 rounded-lg bg-slate-900 border border-slate-700 shadow-lg py-1">
    <%# No Group option %>
    <% if current_group %>
      <%= button_to update_group_request_path(request, request_group_id: nil),
          method: :patch,
          data: { turbo_stream: true },
          class: "w-full text-left px-3 py-2 text-sm text-slate-400 hover:bg-slate-800 hover:text-slate-200 transition-colors flex items-center gap-2" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Remove from Group
      <% end %>
      <div class="border-t border-slate-700 my-1"></div>
    <% end %>

    <%# Existing groups %>
    <% groups.each do |group| %>
      <% is_current = current_group&.id == group.id %>
      <%= button_to update_group_request_path(request, request_group_id: group.id),
          method: :patch,
          data: { turbo_stream: true },
          disabled: is_current,
          class: "w-full text-left px-3 py-2 text-sm transition-colors flex items-center gap-2 #{is_current ? 'bg-purple-900/30 text-purple-300' : 'text-slate-300 hover:bg-slate-800'}" do %>
        <% if is_current %>
          <svg class="h-4 w-4 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <span class="w-4"></span>
        <% end %>
        <%= group.name.truncate(20) %>
      <% end %>
    <% end %>

    <% if groups.any? %>
      <div class="border-t border-slate-700 my-1"></div>
    <% end %>

    <%# Create new group option - could open a modal or inline form %>
    <div class="px-3 py-2">
      <p class="text-xs text-slate-500 mb-1">Create new group</p>
      <%= form_with url: project_request_groups_path(project), method: :post, data: { turbo_stream: true }, class: "flex gap-1" do |f| %>
        <%= f.hidden_field :request_id, value: request.id %>
        <%= f.text_field :name,
            placeholder: "Group name...",
            class: "flex-1 px-2 py-1 text-xs bg-slate-800 border border-slate-600 rounded text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
        <%= f.submit "+",
            class: "px-2 py-1 text-xs font-medium bg-cyan-600 text-white rounded hover:bg-cyan-500 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
