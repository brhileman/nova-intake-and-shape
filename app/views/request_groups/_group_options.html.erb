<%#
  Group options list for dropdown
  Locals: project, selected_group_id (optional)
%>
<%
  project = local_assigns[:project]
  selected_group_id = local_assigns[:selected_group_id]
  groups = project.request_groups.order(:name)
%>

<div id="request_groups_options">
  <% groups.each do |group| %>
    <% is_selected = selected_group_id == group.id %>
    <div class="px-3 py-2 text-sm transition-colors flex items-center gap-2 <%= is_selected ? 'bg-purple-900/30 text-purple-300' : 'text-slate-300' %>">
      <% if is_selected %>
        <svg class="h-4 w-4 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
      <% else %>
        <span class="w-4"></span>
      <% end %>
      <%= group.name.truncate(20) %>
    </div>
  <% end %>
</div>
