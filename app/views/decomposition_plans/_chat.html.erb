<%#
  Decomposition Plan Chat Panel
  Locals: plan, conversation
%>
<%
  plan = local_assigns[:plan]
  conversation = local_assigns[:conversation] || []
  # Show typing indicator when agent is actively working (status is "planning")
  agent_active = plan.status == "planning" && plan.agent_id.present?
%>

<div class="flex flex-col h-full min-h-0">
  <%# Chat Header - flex-shrink-0 keeps it from shrinking %>
  <div class="flex-shrink-0 px-4 py-3 border-b border-slate-700 bg-slate-800/50">
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span class="text-sm font-medium text-slate-300">Planning Conversation</span>
      <% if agent_active %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-900/50 text-amber-400">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          Working
        </span>
      <% end %>
    </div>
  </div>

  <%# Messages - min-h-0 allows shrinking in flex container %>
  <div class="flex-1 overflow-y-auto min-h-0 p-4 space-y-4" id="decomposition_plan_messages"
       data-controller="scroll-bottom"
       data-scroll-bottom-auto-value="true">
    <% if conversation.empty? %>
      <div class="text-center py-8">
        <svg class="h-12 w-12 text-slate-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <p class="text-sm text-slate-500">
          <% if agent_active %>
            Agent is analyzing your initiative...
          <% else %>
            No conversation yet
          <% end %>
        </p>
      </div>
    <% else %>
      <% conversation.each do |message| %>
        <% 
          is_user = message["type"] == "human_message"
          is_agent = message["type"] == "assistant_message"
          raw_text = message["text"].to_s
          # For user messages, extract just the user's actual input (hide system prompts)
          display_text = is_user ? display_message_text(raw_text) : raw_text
        %>
        <% if is_user || is_agent %>
          <div class="flex <%= is_user ? 'justify-end' : 'justify-start' %>">
            <div class="max-w-[90%] rounded-lg px-4 py-3 <%= is_user ? 'bg-cyan-600/20 border border-cyan-600/30' : 'bg-slate-700/50 border border-slate-600' %>">
              <div class="flex items-center gap-2 mb-1">
                <% if is_user %>
                  <span class="text-xs font-medium text-cyan-400">You</span>
                <% else %>
                  <svg class="h-3.5 w-3.5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span class="text-xs font-medium text-purple-400">Planning Agent</span>
                <% end %>
              </div>
              <div class="text-sm text-slate-300 prose prose-sm prose-invert max-w-none">
                <%= simple_format(display_text.truncate(3000)) %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if agent_active %>
      <%# Typing indicator %>
      <div class="flex justify-start">
        <div class="bg-slate-700/50 border border-slate-600 rounded-lg px-4 py-3">
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
              <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
              <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
            </div>
            <span class="text-xs text-slate-500">Agent is thinking...</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# Message Input - flex-shrink-0 ensures it stays visible %>
  <% unless plan.status == "approved" || plan.status == "cancelled" %>
    <div class="flex-shrink-0 px-4 py-3 border-t border-slate-700 bg-slate-800/50">
      <%= form_with url: followup_project_decomposition_plan_path(plan.project, plan), method: :post, data: { turbo_stream: true }, class: "flex gap-2 items-end" do |f| %>
        <textarea name="message"
                  rows="2"
                  placeholder="<%= agent_active ? 'Agent is working...' : 'Send a message...' %>"
                  class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-sm text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 resize-none"
                  <%= "disabled" if agent_active %>></textarea>
        <button type="submit"
                class="px-4 py-2 rounded-lg text-sm font-medium <%= agent_active ? 'bg-slate-700 text-slate-500 cursor-not-allowed' : 'bg-cyan-600 text-white hover:bg-cyan-500' %> transition-colors"
                <%= "disabled" if agent_active %>>
          Send
        </button>
      <% end %>
    </div>
  <% end %>
</div>
