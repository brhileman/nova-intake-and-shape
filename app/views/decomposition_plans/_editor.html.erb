<%#
  Decomposition Plan Editor Modal Content
  Locals: project, plan (DecompositionPlan), conversation (array of messages)
%>
<%
  project = local_assigns[:project]
  plan = local_assigns[:plan]
  conversation = local_assigns[:conversation] || []
  is_new = plan.new_record?
  agent_active = plan.status == "planning" && plan.agent_id.present?
  is_ready = plan.status == "ready"
  needs_clarification = plan.status == "needs_clarification"
%>

<div class="flex flex-col max-h-[85vh]"
     data-controller="decomposition-plan-polling"
     data-decomposition-plan-polling-plan-id-value="<%= plan.id %>"
     data-decomposition-plan-polling-project-id-value="<%= project.id %>"
     data-decomposition-plan-polling-poll-url-value="<%= plan.persisted? ? poll_project_decomposition_plan_path(project, plan) : '' %>"
     data-decomposition-plan-polling-active-value="<%= agent_active %>">

  <%# Hidden status element for polling controller %>
  <div id="decomposition_plan_status_value" data-status="<%= plan.status %>" class="hidden"></div>

  <%# Modal Header %>
  <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700 rounded-t-xl bg-slate-800">
    <div class="flex items-center gap-3">
      <% unless is_new %>
        <%= link_to new_project_decomposition_plan_path(project),
            data: { turbo_frame: "decomposition_plan_modal" },
            class: "rounded-lg p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-700 transition-colors mr-1" do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
      <% end %>
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-cyan-500/20 to-purple-500/20">
        <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-100">
          <%= is_new ? "Create New Plan" : (plan.title.presence || "Planning...") %>
        </h2>
        <p class="text-sm text-slate-400">Break down your initiative into actionable requests</p>
      </div>
    </div>
    <button type="button"
            data-action="click->modal#close"
            class="rounded-lg p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-700 transition-colors">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <%# Modal Body %>
  <div class="flex-1 overflow-hidden bg-slate-800">
    <% if is_new %>
      <%# Initial Input Form %>
      <div class="p-6" data-controller="plan-form">
        <%# Form State %>
        <div data-plan-form-target="form">
          <%= form_with url: project_decomposition_plans_path(project), method: :post, data: { turbo_stream: true, action: "submit->plan-form#submit" } do |f| %>
            <div class="mb-4">
              <label for="original_input" class="block text-sm font-medium text-slate-300 mb-2">
                What do you want to plan?
              </label>
              <%= f.text_area :original_input,
                  placeholder: "Describe your initiative, epic, or project idea...\n\nExamples:\n• \"We want to build a customer portal where users can view their order history\"\n• \"Add multi-tenancy support to the platform\"\n• \"Implement a notification system with email and in-app alerts\"\n• \"Improve the onboarding experience\"",
                  rows: 8,
                  class: "w-full px-4 py-3 text-sm border border-slate-600 rounded-lg bg-slate-900 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 resize-none",
                  data: { plan_form_target: "input" } %>
            </div>
            <div class="flex justify-end">
              <button type="submit" data-plan-form-target="submitBtn"
                  class="px-6 py-2.5 text-sm font-medium text-white bg-cyan-600 rounded-lg hover:bg-cyan-500 transition-colors cursor-pointer inline-flex items-center gap-2">
                <span data-plan-form-target="btnText">Start Planning</span>
                <svg data-plan-form-target="spinner" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>
          <% end %>
        </div>

        <%# Loading State %>
        <div data-plan-form-target="loading" class="hidden">
          <div class="flex flex-col items-center justify-center py-16">
            <div class="relative">
              <div class="h-16 w-16 rounded-full border-4 border-slate-700"></div>
              <div class="absolute top-0 h-16 w-16 rounded-full border-4 border-transparent border-t-cyan-500 animate-spin"></div>
            </div>
            <h3 class="mt-6 text-lg font-medium text-slate-200">Launching Planning Agent</h3>
            <p class="mt-2 text-sm text-slate-400">Analyzing your initiative and preparing questions...</p>
          </div>
        </div>
      </div>
    <% else %>
      <%# Two-column layout: Chat + Preview %>
      <div class="flex h-[60vh]">
        <%# Chat Column %>
        <div class="w-1/2 border-r border-slate-700 flex flex-col">
          <div id="decomposition_plan_chat" class="flex-1 overflow-hidden">
            <%= render "decomposition_plans/chat", plan: plan, conversation: conversation %>
          </div>
        </div>

        <%# Preview Column %>
        <div class="w-1/2 flex flex-col overflow-hidden">
          <div id="decomposition_plan_preview" class="flex-1 overflow-y-auto">
            <% if is_ready && plan.plan_content.present? %>
              <% extractor = DecompositionPlanExtractor.new(plan.plan_content) %>
              <% extracted = extractor.extract %>
              <%= render "decomposition_plans/plan_preview", plan: plan, extracted: extracted %>
            <% else %>
              <div class="flex items-center justify-center h-full p-6">
                <div class="text-center">
                  <svg class="mx-auto h-12 w-12 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <p class="mt-3 text-sm text-slate-400">
                    <% if agent_active %>
                      Plan preview will appear here once the agent finishes...
                    <% elsif needs_clarification %>
                      Answer the agent's questions to continue planning
                    <% else %>
                      Waiting for plan...
                    <% end %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
