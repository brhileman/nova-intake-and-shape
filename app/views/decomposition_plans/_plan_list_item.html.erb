<%#
  Single plan item in the plans list
  Locals: plan, project
%>
<%
  plan = local_assigns[:plan]
  project = local_assigns[:project]
  
  status_config = {
    "planning" => { bg: "bg-amber-900/30", border: "border-amber-700/50", dot: "bg-amber-400", label: "In Progress" },
    "needs_clarification" => { bg: "bg-blue-900/30", border: "border-blue-700/50", dot: "bg-blue-400", label: "Needs Input" },
    "ready" => { bg: "bg-emerald-900/30", border: "border-emerald-700/50", dot: "bg-emerald-400", label: "Ready" },
    "approved" => { bg: "bg-slate-800", border: "border-slate-700", dot: "bg-emerald-500", label: "Approved" },
    "cancelled" => { bg: "bg-slate-800", border: "border-slate-700", dot: "bg-slate-500", label: "Cancelled" }
  }
  
  config = status_config[plan.status] || status_config["planning"]
%>

<%= link_to project_decomposition_plan_path(project, plan),
    data: { turbo_frame: "decomposition_plan_modal" },
    class: "block p-4 rounded-lg border #{config[:border]} #{config[:bg]} hover:bg-slate-700/50 transition-colors" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="h-2 w-2 rounded-full <%= config[:dot] %> <%= 'animate-pulse' if plan.status == 'planning' %>"></span>
        <span class="text-xs text-slate-400"><%= config[:label] %></span>
        <span class="text-xs text-slate-500"><%= time_ago_in_words(plan.created_at) %> ago</span>
      </div>
      <h4 class="text-sm font-medium text-slate-200 truncate">
        <%= plan.title.presence || plan.original_input.truncate(60) %>
      </h4>
      <% if plan.title.present? %>
        <p class="text-xs text-slate-400 mt-1 truncate"><%= plan.original_input.truncate(80) %></p>
      <% end %>
    </div>
    <svg class="h-5 w-5 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
<% end %>
