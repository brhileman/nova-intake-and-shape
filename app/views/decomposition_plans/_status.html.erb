<%#
  Decomposition Plan Status Badge
  Locals: plan
%>
<%
  plan = local_assigns[:plan]
  status = plan&.status || "new"
  
  status_config = {
    "planning" => { bg: "bg-amber-900/50", text: "text-amber-400", icon: "animate-spin", label: "Planning" },
    "needs_clarification" => { bg: "bg-blue-900/50", text: "text-blue-400", icon: nil, label: "Needs Input" },
    "ready" => { bg: "bg-emerald-900/50", text: "text-emerald-400", icon: nil, label: "Ready" },
    "approved" => { bg: "bg-emerald-900/50", text: "text-emerald-400", icon: nil, label: "Approved" },
    "cancelled" => { bg: "bg-slate-700", text: "text-slate-400", icon: nil, label: "Cancelled" }
  }
  
  config = status_config[status] || { bg: "bg-slate-700", text: "text-slate-400", icon: nil, label: "New" }
%>

<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium <%= config[:bg] %> <%= config[:text] %>">
  <% if status == "planning" %>
    <svg class="h-3 w-3 <%= config[:icon] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
    </svg>
  <% elsif status == "needs_clarification" %>
    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  <% elsif status == "ready" %>
    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  <% elsif status == "approved" %>
    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  <% end %>
  <%= config[:label] %>
</span>
