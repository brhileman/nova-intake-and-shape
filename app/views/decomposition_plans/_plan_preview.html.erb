<%#
  Decomposition Plan Preview
  Locals: plan, extracted (Hash with title, summary, scope, requests)
%>
<%
  plan = local_assigns[:plan]
  extracted = local_assigns[:extracted] || {}
  requests = extracted[:requests] || []
  is_ready = plan&.status == "ready"
%>

<% if extracted.blank? || requests.empty? %>
  <div class="flex items-center justify-center h-full p-6">
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p class="mt-3 text-sm text-slate-400">Plan preview will appear here</p>
    </div>
  </div>
<% else %>
  <div class="p-4 space-y-4">
    <%# Plan Header %>
    <div class="bg-slate-900/50 rounded-lg p-4 border border-slate-700">
      <h3 class="text-lg font-semibold text-slate-100 mb-2"><%= extracted[:title] || "Untitled Plan" %></h3>
      <% if extracted[:summary].present? %>
        <p class="text-sm text-slate-400 mb-2"><%= extracted[:summary] %></p>
      <% end %>
      <% if extracted[:scope].present? %>
        <div class="mt-2 pt-2 border-t border-slate-700">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Scope</span>
          <p class="text-sm text-slate-400 mt-1"><%= extracted[:scope] %></p>
        </div>
      <% end %>
    </div>

    <%# Requests List %>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h4 class="text-sm font-medium text-slate-300"><%= requests.count %> Recommended Requests</h4>
        <% if is_ready %>
          <label class="flex items-center gap-2 text-xs text-slate-400 cursor-pointer">
            <input type="checkbox" id="select_all_requests" checked
                   class="rounded border-slate-600 bg-slate-900 text-cyan-500 focus:ring-cyan-500/20"
                   onchange="document.querySelectorAll('.request-checkbox').forEach(cb => cb.checked = this.checked)">
            Select All
          </label>
        <% end %>
      </div>

      <% if is_ready %>
        <%= form_with url: approve_project_decomposition_plan_path(plan.project, plan), method: :post, data: { turbo_stream: true }, id: "approve_plan_form" do |f| %>
          <div class="space-y-2">
            <% requests.each do |request| %>
              <div class="bg-slate-900/30 rounded-lg p-3 border border-slate-700 hover:border-slate-600 transition-colors">
                <div class="flex items-start gap-3">
                  <input type="checkbox" name="selected_requests[]" value="<%= request[:number] %>" checked
                         class="request-checkbox mt-1 rounded border-slate-600 bg-slate-900 text-cyan-500 focus:ring-cyan-500/20">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-medium text-slate-500">#<%= request[:number] %></span>
                      <% 
                        type_colors = {
                          "new_feature" => "bg-emerald-900/50 text-emerald-400",
                          "new" => "bg-emerald-900/50 text-emerald-400",
                          "update" => "bg-blue-900/50 text-blue-400",
                          "fix" => "bg-amber-900/50 text-amber-400"
                        }
                        type_color = type_colors[request[:type]] || "bg-slate-700 text-slate-400"
                      %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium <%= type_color %>">
                        <%= request[:type]&.humanize || "New" %>
                      </span>
                      <% 
                        priority_colors = {
                          "high" => "text-red-400",
                          "medium" => "text-amber-400",
                          "low" => "text-slate-400"
                        }
                        priority_color = priority_colors[request[:priority]] || "text-slate-400"
                      %>
                      <span class="text-xs <%= priority_color %>"><%= request[:priority]&.capitalize || "Medium" %> priority</span>
                    </div>
                    <h5 class="text-sm font-medium text-slate-200 mb-1"><%= request[:title] || "Untitled Request" %></h5>
                    <% if request[:persona].present? && request[:action].present? %>
                      <p class="text-xs text-slate-400">
                        As a <span class="text-slate-300"><%= request[:persona] %></span>,
                        I want <span class="text-slate-300"><%= request[:action].truncate(100) %></span>
                      </p>
                    <% end %>
                    <% if request[:dependencies].present? %>
                      <p class="text-xs text-amber-400/70 mt-1">
                        <svg class="inline h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        Depends on: <%= request[:dependencies] %>
                      </p>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# Action Buttons %>
          <div class="mt-4 flex items-center justify-between pt-4 border-t border-slate-700">
            <%= link_to cancel_project_decomposition_plan_path(plan.project, plan), 
                method: :post, 
                data: { turbo_stream: true },
                class: "text-sm text-slate-400 hover:text-slate-300 transition-colors" do %>
              Cancel
            <% end %>
            <%= f.submit "Create #{requests.count} Requests",
                class: "px-6 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-500 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      <% else %>
        <%# Read-only preview (not ready yet) %>
        <div class="space-y-2">
          <% requests.each do |request| %>
            <div class="bg-slate-900/30 rounded-lg p-3 border border-slate-700">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-medium text-slate-500">#<%= request[:number] %></span>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-slate-700 text-slate-400">
                  <%= request[:type]&.humanize || "New" %>
                </span>
              </div>
              <h5 class="text-sm font-medium text-slate-200"><%= request[:title] || "Untitled Request" %></h5>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
