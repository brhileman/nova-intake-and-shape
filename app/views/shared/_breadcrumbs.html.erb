<%# Breadcrumbs navigation component %>
<%# Usage: render "shared/breadcrumbs", breadcrumbs: [{ label: "Home", path: root_path }, { label: "Project", path: nil }] %>
<nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4">
  <% breadcrumbs.each_with_index do |crumb, index| %>
    <% if index > 0 %>
      <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>
    <% if crumb[:path] %>
      <%= link_to crumb[:label], crumb[:path], class: "hover:text-white transition-colors" %>
    <% else %>
      <span class="text-slate-200 font-medium"><%= crumb[:label] %></span>
    <% end %>
  <% end %>
</nav>
