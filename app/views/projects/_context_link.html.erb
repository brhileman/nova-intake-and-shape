<%# Context link that opens the editor modal %>
<% project = local_assigns[:project] %>
<span id="context_link">
  <button type="button"
          data-action="click->modal#open"
          class="inline-flex items-center gap-1.5 text-sm text-[#00b4d8] hover:text-[#0096b4] hover:underline transition-colors">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <% if project.context_docs.present? %>
      Agent Context File
      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400" title="Context configured"></span>
    <% else %>
      Add Agent Context File
    <% end %>
  </button>
</span>
