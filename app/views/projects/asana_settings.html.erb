<turbo-frame id="asana_settings_modal">
  <div class="p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold text-white">Asana Integration</h2>
      <button type="button" data-action="click->modal#close" class="text-slate-400 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <% if @project.asana_access_token.blank? %>
      <div class="bg-amber-900/30 border border-amber-700 rounded-lg p-4 mb-4">
        <p class="text-amber-300 text-sm">
          <strong>No Asana access token configured.</strong>
          Set the <code class="bg-slate-700 px-1 rounded">ASANA_ACCESS_TOKEN</code> environment variable with a
          <a href="https://app.asana.com/0/developer-console" target="_blank" class="underline hover:text-amber-200">Personal Access Token</a>.
        </p>
      </div>
    <% elsif @asana_error.present? %>
      <div class="bg-red-900/30 border border-red-700 rounded-lg p-4 mb-4">
        <p class="text-red-300 text-sm">
          <strong>Asana API error:</strong> <%= @asana_error %>
        </p>
      </div>
    <% end %>

    <%= form_with url: asana_settings_project_path(@project), method: :post, data: { turbo: true } do |f| %>
      <div class="space-y-4">
        <%# Workspace selector %>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Workspace</label>
          <% if @workspaces.any? %>
            <select name="asana_workspace_gid"
                    class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <option value="">Select a workspace...</option>
              <% @workspaces.each do |ws| %>
                <option value="<%= ws["gid"] %>" <%= "selected" if ws["gid"] == @project.asana_workspace_gid %>>
                  <%= ws["name"] %>
                </option>
              <% end %>
            </select>
          <% else %>
            <input type="text" name="asana_workspace_gid"
                   value="<%= @project.asana_workspace_gid %>"
                   placeholder="Workspace GID (e.g. 1234567890)"
                   class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500">
            <p class="mt-1 text-xs text-slate-500">Enter the workspace GID manually, or configure ASANA_ACCESS_TOKEN to load workspaces.</p>
          <% end %>
        </div>

        <%# Project selector %>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Asana Project</label>
          <% if @asana_projects.any? %>
            <select name="asana_project_gid"
                    class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <option value="">Select a project...</option>
              <% @asana_projects.each do |proj| %>
                <option value="<%= proj["gid"] %>" <%= "selected" if proj["gid"] == @project.asana_project_gid %>>
                  <%= proj["name"] %>
                </option>
              <% end %>
            </select>
          <% else %>
            <input type="text" name="asana_project_gid"
                   value="<%= @project.asana_project_gid %>"
                   placeholder="Project GID (from Asana URL: app.asana.com/0/{GID}/...)"
                   class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500">
            <p class="mt-1 text-xs text-slate-500">Enter the project GID from the Asana URL, or select a workspace above first to load projects.</p>
          <% end %>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-700">
          <div id="asana_save_status"></div>
          <button type="submit"
                  class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg font-medium text-sm transition-colors">
            Save Asana Settings
          </button>
        </div>
      </div>
    <% end %>
  </div>
</turbo-frame>
