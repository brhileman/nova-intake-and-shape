<%# Breadcrumbs %>
<%= render "shared/breadcrumbs", breadcrumbs: breadcrumb_for_project(@project) %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-100"><%= @project.name %></h1>
  <p class="text-slate-400 mt-1">Manage development requests for this project</p>
</div>

<%# Filter tabs %>
<div class="mb-4 border-b border-slate-700">
  <div class="flex items-end justify-between">
    <nav class="-mb-px flex space-x-6" aria-label="Tabs">
    <%
      filters = [
        ["all", "All Requests", nil],
        ["needs_my_action", "Needs My Action", "bg-amber-900/50 text-amber-300"],
        ["in_review", "In Review", nil],
        ["created_by_me", "Created by Me", nil]
      ]
      current_filter = @current_filter || "all"
    %>
    <% filters.each do |filter_key, filter_label, badge_class| %>
      <% is_active = current_filter == filter_key %>
      <%= link_to project_path(@project, filter: filter_key == "all" ? nil : filter_key),
                  class: "whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium transition-colors #{is_active ? 'border-[#00b4d8] text-[#00b4d8]' : 'border-transparent text-slate-400 hover:text-slate-200 hover:border-slate-500'}" do %>
        <%= filter_label %>
        <% if filter_key == "needs_my_action" && current_user %>
          <% count = @project.requests.needs_action_from(current_user).count %>
          <% if count > 0 %>
            <span class="ml-1.5 inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium rounded-full <%= badge_class || 'bg-slate-700 text-slate-300' %>">
              <%= count %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    </nav>
    <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-[#00b4d8] px-4 py-2.5 mb-3 text-sm font-semibold text-white shadow-sm hover:bg-[#0096b4] transition-colors" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New Request
    <% end %>
  </div>
</div>

<% if @requests.empty? %>
  <div class="text-center py-12 bg-slate-800 rounded-lg border border-slate-700">
    <svg class="mx-auto h-12 w-12 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>
    <h3 class="mt-2 text-sm font-semibold text-slate-100">No requests</h3>
    <p class="mt-1 text-sm text-slate-400">Get started by creating a new request.</p>
    <div class="mt-6">
      <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-[#00b4d8] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#0096b4]" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Request
      <% end %>
    </div>
  </div>
<% else %>
  <div class="bg-slate-800 rounded-lg border border-slate-700 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-slate-700">
      <thead class="bg-slate-800/50">
        <tr>
          <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Request
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Type
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Date Requested
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Stage
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Agent Status
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Pending
          </th>
          <th scope="col" class="relative py-3 pl-3 pr-4">
            <span class="sr-only">View</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-700/50 bg-slate-800">
        <% @requests.each do |request| %>
          <%= render "requests/request_row", request: request %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
