<%= turbo_frame_tag "context_modal" do %>
  <div class="flex flex-col max-h-[85vh]">
    <%# Modal Header %>
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700 rounded-t-xl">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-800">
          <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-slate-100">Project Agent Context</h2>
          <p class="text-sm text-slate-400">Context sent to agents with each request</p>
        </div>
      </div>
      <button type="button"
              data-action="click->modal#close"
              class="rounded-lg p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-700 transition-colors">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%# Modal Body %>
    <%= form_with url: context_project_path(@project), method: :post, data: { turbo_stream: true } do |f| %>
      <div class="p-6 bg-slate-800">
        <textarea name="context_docs"
                  rows="20"
                  class="w-full bg-slate-900 border border-slate-700 rounded-lg p-4 text-slate-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-[#00b4d8]/50 focus:border-[#00b4d8] resize-none"
                  placeholder="# Product Context for Agents

## Product Overview
- What this product does:
- Who it's for:
- What success looks like:
- Out of scope:

## Users and Personas
- Primary user types:
- High-level goals for each:
- Important access or visibility constraints:

## Core Product Rules
- Assumptions that must always hold true:
  - ...
- Irreversible or high-risk actions:
- Key concepts that should not be reinterpreted:

## Compliance and Trust
- Relevant compliance or regulatory considerations:
- Sensitive data types:
- Logging, visibility, and audit expectations:

## Integrations and Dependencies
- External systems this product relies on:
- Who owns the source of truth:
- Known fragile or high-impact areas:

## Operational Considerations
- Environment differences that matter:
- Use of feature flags:
- Changes that require extra caution:

## Definition of &quot;Done&quot;
- Quality expectations for changes:
- When documentation or tracking should be updated:

## Common Pitfalls and Best Practices
- Common mistakes to avoid:
- Patterns that usually lead to good outcomes:"><%= @project.context_docs %></textarea>
      </div>

      <%# Modal Footer %>
      <div class="flex items-center justify-between px-6 py-4 border-t border-slate-700 rounded-b-xl">
        <div id="context_save_status"></div>
        <div class="flex items-center gap-3">
          <button type="button"
                  data-action="click->modal#close"
                  class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 border border-slate-600 rounded-lg hover:bg-slate-600 transition-colors">
            Cancel
          </button>
          <button type="submit"
                  class="px-4 py-2 text-sm font-medium text-white bg-[#00b4d8] rounded-lg hover:bg-[#0096b4] transition-colors">
            Save Context
          </button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
