<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<%# 
  Artifact statuses:
  - Brief: not_started (no brief) | drafted (intake_clarified) | approved (planning phase+)
  - Plan: not_started (no plan) | drafted (planning_clarified) | approved (execution phase+)
  - Execution: not_started (no execution) | in_progress (execution exists) | completed (request completed)
%>
<%
  # Determine brief status
  brief_status = if req.latest_brief.nil?
    :not_started
  elsif %w[intake_clarified intake_needs_clarification intake_in_progress].include?(req.status) || req.current_phase == "intake"
    :drafted
  else
    :approved
  end

  # Determine plan status
  plan_status = if req.latest_plan.nil?
    :not_started
  elsif %w[planning_clarified planning_needs_clarification planning_in_progress].include?(req.status) || req.current_phase == "planning"
    :drafted
  else
    :approved
  end

  # Determine execution status
  execution_status = if req.execution.nil?
    :not_started
  elsif %w[execution_review completed].include?(req.status)
    :completed
  else
    :in_progress
  end
%>

<div class="px-4 py-3 border-b border-slate-700">
  <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-3">Artifacts</h3>
  
  <div class="space-y-2">
    <%# Brief Artifact Button %>
    <%= render "artifact_button", 
               artifact_type: "brief",
               status: brief_status,
               artifact: req.latest_brief,
               request: req %>

    <%# Plan Artifact Button %>
    <%= render "artifact_button", 
               artifact_type: "plan",
               status: plan_status,
               artifact: req.latest_plan,
               request: req %>

    <%# Design Guidance (always shown - marked as optional or required) %>
    <%= render "artifact_design", request: req %>

    <%# Execution (when complete) %>
    <% if req.execution %>
      <%= render "artifact_execution", execution: req.execution, compact: true, status: execution_status %>
      <% if req.status == "execution_review" %>
        <div class="rounded-lg border border-amber-700/50 bg-amber-900/30 p-2 text-center">
          <p class="text-xs font-medium text-amber-400">Waiting for PR review</p>
        </div>
      <% end %>
    <% elsif %w[intake planning].include?(req.current_phase) %>
      <div class="rounded-lg border border-dashed border-slate-600 p-3 text-center">
        <svg class="mx-auto h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <p class="mt-1 text-xs font-medium text-slate-400">Execution</p>
        <p class="text-xs text-slate-500">After plan approval</p>
      </div>
    <% elsif req.current_phase == "execution" && !req.execution %>
      <div class="rounded-lg border border-purple-700/50 bg-purple-900/30 p-3 text-center">
        <div class="animate-pulse flex justify-center">
          <div class="h-5 w-5 rounded-full bg-purple-700"></div>
        </div>
        <p class="mt-1 text-xs font-medium text-purple-400">Executing...</p>
      </div>
    <% end %>
  </div>
</div>
