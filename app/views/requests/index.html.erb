<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-100">Shaped Tasks</h1>
    <p class="text-slate-400 mt-1">History of intake requests shaped into tasks</p>
  </div>
  <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-cyan-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-cyan-700 transition-colors" do %>
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    New Request
  <% end %>
</div>

<%# Filter tabs %>
<div class="mb-4 border-b border-slate-700">
  <nav class="-mb-px flex space-x-6" aria-label="Tabs">
    <%
      filters = [
        ["all", "All"],
        ["created_by_me", "Created by Me"]
      ]
      current_filter = @current_filter || "all"
    %>
    <% filters.each do |filter_key, filter_label| %>
      <% is_active = current_filter == filter_key %>
      <%= link_to requests_path(filter: filter_key == "all" ? nil : filter_key),
                  class: "whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium transition-colors #{is_active ? 'border-cyan-500 text-cyan-400' : 'border-transparent text-slate-400 hover:text-slate-200 hover:border-slate-500'}" do %>
        <%= filter_label %>
      <% end %>
    <% end %>
  </nav>
</div>

<% if @requests.empty? %>
  <div class="text-center py-12 bg-slate-800 rounded-lg border border-slate-700">
    <svg class="mx-auto h-12 w-12 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>
    <h3 class="mt-2 text-sm font-semibold text-slate-100">No shaped tasks yet</h3>
    <p class="mt-1 text-sm text-slate-400">Create a new request to start the intake & shape flow.</p>
    <div class="mt-6">
      <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-cyan-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-cyan-700" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Request
      <% end %>
    </div>
  </div>
<% else %>
  <div class="bg-slate-800 rounded-lg border border-slate-700 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-slate-700">
      <thead class="bg-slate-800/50">
        <tr>
          <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Request
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Type
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Date
          </th>
          <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400">
            Asana
          </th>
          <th scope="col" class="relative py-3 pl-3 pr-4">
            <span class="sr-only">View</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-700/50 bg-slate-800">
        <% @requests.each do |request| %>
          <%= render "request_row", request: request %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
