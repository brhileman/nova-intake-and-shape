<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-[#1a1a2e]">Requests</h1>
    <p class="text-slate-500 mt-1">Manage your development requests</p>
  </div>
  <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-[#00b4d8] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#0096b4] transition-colors" do %>
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    New Request
  <% end %>
</div>

<% if @requests.empty? %>
  <div class="text-center py-12 bg-white rounded-lg border border-slate-200">
    <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>
    <h3 class="mt-2 text-sm font-semibold text-slate-900">No requests</h3>
    <p class="mt-1 text-sm text-slate-500">Get started by creating a new request.</p>
    <div class="mt-6">
      <%= link_to new_request_path, class: "inline-flex items-center gap-2 rounded-lg bg-[#00b4d8] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#0096b4]" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Request
      <% end %>
    </div>
  </div>
<% else %>
  <div class="space-y-4">
    <% @requests.each do |request| %>
      <%= render "request_card", request: request %>
    <% end %>
  </div>
<% end %>
