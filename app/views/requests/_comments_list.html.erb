<%# Comments list content - used for turbo stream updates %>
<% team_comments = request.comments.team.order(:created_at) %>

<% if team_comments.empty? %>
  <div class="flex flex-col items-center justify-center h-full text-center py-12">
    <svg class="w-12 h-12 text-slate-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
    <p class="text-slate-400 text-sm">No team comments yet</p>
    <p class="text-slate-500 text-xs mt-1">Start a discussion with your team</p>
  </div>
<% else %>
  <% team_comments.each do |comment| %>
    <div class="bg-slate-800 rounded-lg p-4">
      <div class="flex items-start gap-3">
        <%# Avatar %>
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-600 flex items-center justify-center">
          <span class="text-xs font-medium text-slate-300">
            <%= comment.user&.name&.first&.upcase || '?' %>
          </span>
        </div>
        
        <%# Content %>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-sm font-medium text-slate-200"><%= comment.user&.name || 'Unknown' %></span>
            <span class="text-xs text-slate-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="text-sm text-slate-300 whitespace-pre-wrap"><%= comment.content %></p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
