<%# Technical guidance form - simple editable text area %>
<% technical_guidance = request.technical_guidance || request.build_technical_guidance %>
<% locked = request.in_execution_phase? %>

<div class="flex-1 flex flex-col h-full">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-white">Technical Guidance</h2>
  </div>
  
  <%# Locked banner when in execution phase %>
  <% if locked %>
    <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="text-sm text-slate-400">Technical guidance locked — Build has started</span>
    </div>
    
    <p class="text-sm text-slate-400 mb-4">
      Technical notes and implementation guidelines that were provided for the build.
    </p>
    
    <%# Read-only display when locked %>
    <div class="flex-1 mb-4">
      <div class="w-full h-full min-h-[300px] p-4 bg-slate-800/50 border border-slate-700 rounded-lg text-slate-300 text-sm font-mono whitespace-pre-wrap">
        <% if technical_guidance.notes.present? %>
          <%= technical_guidance.notes %>
        <% else %>
          <span class="text-slate-500 italic">No technical guidance provided</span>
        <% end %>
      </div>
    </div>
  <% else %>
  
  <p class="text-sm text-slate-400 mb-4">
    Add technical notes, implementation guidelines, or constraints that should be considered during the build phase. 
    These notes will be passed to the execution agent along with the plan and design guidance.
  </p>
  
  <%= form_with model: [request, technical_guidance], 
      url: request_technical_guidance_path(request),
      method: technical_guidance.persisted? ? :patch : :post,
      local: true,
      class: "flex-1 flex flex-col" do |f| %>
    
    <%# Technical notes textarea %>
    <div class="flex-1 mb-4">
      <%= f.text_area :notes, 
          placeholder: "Enter technical notes, implementation constraints, code patterns to follow, or other guidance for the execution agent...",
          class: "w-full h-full min-h-[300px] p-4 bg-slate-800 border border-slate-700 rounded-lg text-slate-200 text-sm font-mono resize-none focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
    </div>
    
    <%# Submit button %>
    <div>
      <%= f.submit "Save Technical Guidance",
          class: "w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" %>
    </div>
  <% end %>
  <% end %>
</div>
