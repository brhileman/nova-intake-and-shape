<%# Team Comments Section - Internal team discussions outside agent context %>
<% req = local_assigns[:request] || @request %>
<% team_comments = req.comments.team.order(:created_at) %>

<div class="border-t border-slate-700 mt-4">
  <%# Section Header %>
  <div class="px-4 py-3 flex items-center justify-between">
    <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider flex items-center gap-2">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
      </svg>
      Team Comments
    </h3>
    <span class="text-xs text-slate-500"><%= team_comments.count %></span>
  </div>

  <%# Comments List %>
  <div id="team_comments_list_<%= req.id %>" class="px-4 max-h-64 overflow-y-auto space-y-3">
    <% if team_comments.empty? %>
      <p class="text-sm text-slate-500 py-2 text-center">No team comments yet</p>
    <% else %>
      <% team_comments.each do |comment| %>
        <%= render "team_comment", comment: comment %>
      <% end %>
    <% end %>
  </div>

  <%# Comment Input Form %>
  <div class="px-4 py-3">
    <%= form_with url: team_comment_request_path(req), 
                  method: :post, 
                  data: { 
                    controller: "team-comment-form",
                    turbo_frame: "_top"
                  },
                  class: "flex gap-2" do |f| %>
      <%= f.text_field :message, 
                       placeholder: "Add a team comment...",
                       autocomplete: "off",
                       data: { 
                         team_comment_form_target: "input",
                         action: "keydown.enter->team-comment-form#submit"
                       },
                       class: "flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      <%= f.submit "Send",
                   data: { team_comment_form_target: "button" },
                   class: "px-3 py-2 bg-slate-600 hover:bg-slate-500 text-slate-200 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    <% end %>
  </div>
</div>
