<%# Dependencies Input %>
<% request = local_assigns[:request] %>
<div id="request_dependencies_<%= request.id %>" class="space-y-1" data-controller="inline-edit">
  <div class="flex items-center justify-between">
    <span class="text-xs text-slate-500">Dependencies</span>
    <button type="button" 
            data-action="click->inline-edit#toggle"
            class="text-xs text-slate-500 hover:text-slate-300 transition-colors">
      <% if request.dependencies.present? %>
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
      <% else %>
        <span>+ Add</span>
      <% end %>
    </button>
  </div>

  <%# Display mode %>
  <div data-inline-edit-target="display" class="<%= request.dependencies.blank? ? 'hidden' : '' %>">
    <% if request.dependencies.present? %>
      <span class="text-xs text-cyan-400"><%= request.dependencies.truncate(30) %></span>
    <% end %>
  </div>

  <%# Edit mode %>
  <div data-inline-edit-target="form" class="hidden">
    <%= form_with url: update_dependencies_request_path(request), method: :patch, data: { turbo_stream: true, action: "submit->inline-edit#submit" }, class: "space-y-2" do |f| %>
      <input type="text"
             name="dependencies"
             value="<%= request.dependencies %>"
             placeholder="e.g., Request 1, Request 3"
             class="w-full bg-slate-900 border border-slate-600 rounded px-2 py-1 text-xs text-slate-300 placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/50 focus:border-cyan-500">
      <div class="flex gap-1">
        <button type="submit" class="text-xs px-2 py-0.5 bg-cyan-600 text-white rounded hover:bg-cyan-500 transition-colors">
          Save
        </button>
        <button type="button" data-action="click->inline-edit#cancel" class="text-xs px-2 py-0.5 text-slate-400 hover:text-slate-200 transition-colors">
          Cancel
        </button>
      </div>
    <% end %>
  </div>
</div>
