<%# Build Log panel - displayed in Column 3 %>
<%# Shows execution agent conversation and allows user feedback %>

<div class="flex-1 flex flex-col h-full overflow-hidden"
     data-controller="build-log">
  <%# Header - fixed at top %>
  <div class="flex-shrink-0 flex items-center justify-between mb-4">
    <div>
      <h2 class="text-lg font-semibold text-white">Build Log</h2>
      <p class="text-sm text-slate-400 mt-1">
        <% if request.execution_in_progress? %>
          <span class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
            Agent is working...
          </span>
        <% elsif request.completed? %>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Build complete
          </span>
        <% else %>
          Build not started
        <% end %>
      </p>
    </div>
    
    <%# PR link when completed %>
    <% if request.completed? && request.execution&.pr_url.present? %>
      <%= link_to request.execution.pr_url, 
          class: "flex items-center gap-2 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-md font-medium text-sm transition-colors",
          target: "_blank", rel: "noopener noreferrer" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        View PR
      <% end %>
    <% end %>
  </div>
  
  <%# Messages area - scrollable %>
  <div id="build_log_messages_<%= request.id %>" 
       class="flex-1 min-h-0 overflow-y-auto mb-4 space-y-4"
       data-action="turbo:before-stream-render->build-log#messagesUpdated">
    <%= render "build_log_messages", request: request, conversation: conversation %>
    
    <%# Typing indicator - shown when waiting for agent response %>
    <div data-build-log-target="typingIndicator" class="hidden">
      <div class="flex justify-start">
        <div class="max-w-[85%]">
          <div class="flex items-end gap-2">
            <div class="flex-shrink-0 h-7 w-7 rounded-full flex items-center justify-center bg-slate-700">
              <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="rounded-2xl px-4 py-3 bg-slate-800 border border-slate-700 rounded-bl-md">
              <div class="flex items-center gap-1">
                <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
                <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
                <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
              </div>
            </div>
          </div>
          <p class="mt-1 text-xs text-slate-500 ml-9">Agent is thinking...</p>
        </div>
      </div>
    </div>
  </div>
  
  <%# Input section - fixed at bottom, during execution or after completion %>
  <% if request.execution_in_progress? || request.completed? %>
    <div class="flex-shrink-0 border-t border-slate-700 pt-4 pb-2">
      <h3 class="text-sm font-medium text-slate-300 mb-2">
        <%= request.execution_in_progress? ? "Send feedback to agent" : "Request changes" %>
      </h3>
      
      <%= form_with url: comment_request_path(request), method: :post, local: false, 
          data: { turbo_stream: true, action: "submit->build-log#sendMessage" },
          class: "flex gap-2" do |f| %>
        <%= f.text_field :message, 
            data: { build_log_target: "input" },
            placeholder: request.execution_in_progress? ? "Provide feedback or additional instructions..." : "Describe changes you'd like the agent to make...",
            class: "flex-1 px-3 py-2 bg-slate-800 border border-slate-700 rounded-md text-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
        <%= f.submit "Send",
            class: "px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</div>
