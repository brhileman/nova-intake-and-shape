<%# Usage: render "empty_state", message: "...", phase: "planning" %>
<% msg = local_assigns[:message] || "Coming soon" %>
<% phase_text = local_assigns[:phase] %>
<div class="flex items-center gap-1.5 text-slate-400 text-sm">
  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span><%= msg %></span>
  <% if phase_text.present? %>
    <span class="text-slate-300">•</span>
    <span class="text-slate-400">Available after <%= phase_text %></span>
  <% end %>
</div>
