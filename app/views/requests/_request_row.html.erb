<%# Table row for shaped task - simplified for intake & shape tool %>
<%
  type_color = case request.request_type
  when "new_feature" then "bg-emerald-900/50 text-emerald-300"
  when "update" then "bg-blue-900/50 text-blue-300"
  when "fix" then "bg-red-900/50 text-red-300"
  when "chore" then "bg-slate-600 text-slate-300"
  else "bg-slate-700 text-slate-300"
  end
  
  type_label = case request.request_type
  when "new_feature" then "New Feature"
  when "update" then "Update"
  when "fix" then "Bug Fix"
  when "chore" then "Chore"
  else nil
  end
%>

<tr class="group hover:bg-slate-700/50 transition-colors">
  <%# Request title column %>
  <td class="py-3 pl-4 pr-3">
    <%= link_to request_path(request), class: "block" do %>
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0">
          <% if request.draft? %>
            <span class="flex h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse" title="Draft - In Review"></span>
          <% elsif request.pushed_to_asana? %>
            <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500" title="Pushed to Asana"></span>
          <% else %>
            <span class="flex h-2.5 w-2.5 rounded-full bg-slate-500" title="Finalized"></span>
          <% end %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-slate-100 truncate group-hover:text-cyan-400 transition-colors">
            <% if request.request_number %>
              <span class="text-slate-400 font-normal">REQ-<%= request.request_number %>:</span>
            <% end %>
            <%= request.display_title.truncate(50) %>
          </p>
        </div>
      </div>
    <% end %>
  </td>

  <%# Type column %>
  <td class="px-3 py-3 whitespace-nowrap">
    <% if type_label %>
      <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= type_color %>">
        <%= type_label %>
      </span>
    <% else %>
      <span class="text-slate-500 text-sm">&mdash;</span>
    <% end %>
  </td>

  <%# Date column %>
  <td class="px-3 py-3 whitespace-nowrap text-sm text-slate-400">
    <%= request.created_at.strftime("%b %d, %Y") %>
  </td>

  <%# Status column %>
  <td class="px-3 py-3 whitespace-nowrap">
    <% if request.draft? %>
      <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-900/50 px-2 py-1 text-xs font-medium text-amber-300">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        Draft
      </span>
    <% elsif request.pushed_to_asana? %>
      <a href="<%= request.asana_url %>" target="_blank" rel="noopener"
         class="inline-flex items-center gap-1.5 rounded-md bg-emerald-900/50 px-2 py-1 text-xs font-medium text-emerald-300 hover:bg-emerald-900/70 transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        In Asana
      </a>
    <% else %>
      <span class="inline-flex items-center rounded-md bg-slate-700 px-2 py-1 text-xs font-medium text-slate-400">
        Finalized
      </span>
    <% end %>
  </td>

  <%# Action column %>
  <td class="relative py-3 pl-3 pr-4 text-right">
    <%= link_to request_path(request), class: "text-slate-400 hover:text-cyan-400 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>
  </td>
</tr>
