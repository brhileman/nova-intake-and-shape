<%# Metadata panel - Column 2 of the new layout %>
<div class="p-4 space-y-4">
  <%# Request number and title %>
  <div>
    <span class="text-xs text-slate-500 font-mono">REQ-<%= request.request_number %></span>
    <h1 class="text-lg font-semibold text-white mt-1 leading-tight">
      <%= request.display_title %>
    </h1>
    
    <%# Status pill %>
    <div class="mt-2">
      <span class="px-2 py-1 rounded-full text-xs font-medium 
        <%= request.in_execution_phase? ? 'bg-cyan-500/20 text-cyan-400' : 'bg-slate-600 text-slate-300' %>">
        <%= request.in_execution_phase? ? 'Execution' : 'Planning' %>
      </span>
    </div>
  </div>
  
  <%# Original request - collapsable %>
  <div data-controller="collapse" class="border-t border-slate-700 pt-4">
    <button data-action="collapse#toggle" 
            class="flex items-center justify-between w-full text-left text-sm text-slate-400 hover:text-white transition-colors">
      <span>Original request</span>
      <svg data-collapse-target="icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div data-collapse-target="content" class="hidden mt-2">
      <p class="text-sm text-slate-300 bg-slate-700/50 p-3 rounded">
        <%= request.original_input %>
      </p>
    </div>
  </div>
  
  <%# Metadata fields %>
  <div class="border-t border-slate-700 pt-4 space-y-3">
    <%# Group %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Group</span>
      <span class="text-slate-300"><%= request.request_group&.name || 'None' %></span>
    </div>
    
    <%# Type %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Type</span>
      <span class="text-slate-300"><%= request.request_type&.humanize || 'Not set' %></span>
    </div>
    
    <%# Priority %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Priority</span>
      <span class="text-slate-300"><%= request.priority&.humanize || 'Not set' %></span>
    </div>
    
    <%# Dependencies %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Dependencies</span>
      <span class="text-slate-300"><%= request.dependencies.presence || 'None' %></span>
    </div>
    
    <%# Created date %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Created</span>
      <span class="text-slate-300"><%= time_ago_in_words(request.created_at) %> ago</span>
    </div>
    
    <%# Created by %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">Created by</span>
      <span class="text-slate-300"><%= request.created_by&.name || 'Unknown' %></span>
    </div>
  </div>
  
  <%# Panel selectors %>
  <div class="border-t border-slate-700 pt-4 space-y-2">
    <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">Planning Artifacts</p>
    
    <%= link_to request_path(request, panel: 'plan'), 
        class: "block w-full text-left px-3 py-2 rounded text-sm transition-colors #{active_panel == 'plan' ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
      <span class="flex items-center justify-between">
        <span>Request Plan</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    <% end %>
    
    <%= link_to request_path(request, panel: 'design'), 
        class: "block w-full text-left px-3 py-2 rounded text-sm transition-colors #{active_panel == 'design' ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
      <span class="flex items-center justify-between">
        <span>Design Guidance</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    <% end %>
    
    <%= link_to request_path(request, panel: 'technical'), 
        class: "block w-full text-left px-3 py-2 rounded text-sm transition-colors #{active_panel == 'technical' ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
      <span class="flex items-center justify-between">
        <span>Technical Guidance</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    <% end %>
    
    <%= link_to request_path(request, panel: 'comments'), 
        class: "block w-full text-left px-3 py-2 rounded text-sm transition-colors #{active_panel == 'comments' ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
      <span class="flex items-center justify-between">
        <span>
          Team Comments
          <% if request.comments.team.any? %>
            <span class="ml-2 px-1.5 py-0.5 bg-slate-600 rounded text-xs"><%= request.comments.team.count %></span>
          <% end %>
        </span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    <% end %>
    
    <p class="text-xs text-slate-500 uppercase tracking-wide mb-2 mt-4">Execution</p>
    
    <%= link_to request_path(request, panel: 'build'), 
        class: "block w-full text-left px-3 py-2 rounded text-sm transition-colors #{active_panel == 'build' ? 'bg-slate-700 text-white' : 'text-slate-300 hover:bg-slate-700/50 hover:text-white'}" do %>
      <span class="flex items-center justify-between">
        <span class="flex items-center gap-2">
          Build Log
          <% if request.execution_in_progress? %>
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
          <% elsif request.completed? %>
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <% end %>
        </span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    <% end %>
  </div>
  
  <%# Build button / PR link %>
  <div class="border-t border-slate-700 pt-4">
    <% if request.completed? && request.execution&.pr_url.present? %>
      <%= link_to request.execution.pr_url, 
          class: "flex items-center justify-center gap-2 w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-md font-medium text-sm transition-colors",
          target: "_blank", rel: "noopener noreferrer" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        View PR
      <% end %>
    <% elsif request.execution_in_progress? %>
      <div class="flex items-center justify-center gap-2 w-full px-4 py-2 bg-slate-600 text-slate-300 rounded-md font-medium text-sm">
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Building...
      </div>
    <% elsif request.plan_ready? %>
      <%= button_to build_request_path(request), 
          method: :post,
          class: "flex items-center justify-center gap-2 w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md font-medium text-sm transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Build
      <% end %>
    <% end %>
  </div>
  
</div>
