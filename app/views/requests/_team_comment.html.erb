<%# Individual Team Comment %>
<% comment = local_assigns[:comment] %>

<div class="flex gap-2">
  <%# Avatar %>
  <div class="flex-shrink-0">
    <div class="h-7 w-7 rounded-full flex items-center justify-center bg-slate-700">
      <span class="text-xs font-medium text-slate-300">
        <%= comment.display_author_name.first.upcase %>
      </span>
    </div>
  </div>

  <%# Comment Content %>
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-2">
      <span class="text-sm font-medium text-slate-300 truncate">
        <%= comment.display_author_name %>
      </span>
      <% if comment.user&.role.present? %>
        <span class="text-xs px-1.5 py-0.5 rounded bg-slate-700 text-slate-400 uppercase">
          <%= comment.user.role %>
        </span>
      <% end %>
      <span class="text-xs text-slate-500">
        <%= time_ago_in_words(comment.created_at) %> ago
      </span>
    </div>
    <p class="mt-0.5 text-sm text-slate-400 break-words">
      <%= comment.content %>
    </p>
  </div>
</div>
