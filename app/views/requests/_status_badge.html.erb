<%# Status badge with colors based on state - dark mode %>
<%
  badge_classes = case status
  when /pending$/
    "bg-slate-700 text-slate-300"
  when /in_progress$/
    "bg-amber-900/50 text-amber-400 animate-pulse"
  when /needs_clarification$/
    "bg-yellow-900/50 text-yellow-400"
  when "plan_ready"
    "bg-cyan-900/50 text-cyan-400 font-semibold"
  when /review$/
    "bg-cyan-900/50 text-cyan-400 font-semibold"
  when "completed"
    "bg-emerald-900/50 text-emerald-400"
  else
    "bg-slate-700 text-slate-300"
  end
  
  # Human-readable label
  label = case status
  when "intake_pending" then "Pending"
  when "intake_in_progress" then "Planning In Progress"
  when "intake_needs_clarification" then "Needs Clarification"
  when "plan_ready" then "Plan Ready"
  when "execution_pending" then "Execution Pending"
  when "execution_in_progress" then "Execution In Progress"
  when "execution_review" then "Execution Review"
  when "completed" then "Completed"
  else status.humanize
  end
%>

<span class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium <%= badge_classes %>">
  <% if status == "plan_ready" || status.end_with?("_review") %>
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00b4d8] opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00b4d8]"></span>
    </span>
  <% elsif status.end_with?("_needs_clarification") %>
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  <% elsif status.end_with?("_in_progress") %>
    <svg class="h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  <% elsif status == "completed" %>
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  <% end %>
  <%= label %>
</span>
