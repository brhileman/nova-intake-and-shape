<%# Status badge with colors based on state %>
<%
  badge_classes = case status
  when /pending$/
    "bg-slate-100 text-slate-600"
  when /in_progress$/
    "bg-amber-100 text-amber-700 animate-pulse"
  when /review$/
    "bg-[#00b4d8]/10 text-[#00b4d8] font-semibold"
  when "completed"
    "bg-emerald-100 text-emerald-700"
  else
    "bg-slate-100 text-slate-600"
  end
  
  # Human-readable label
  label = case status
  when "intake_pending" then "Intake Pending"
  when "intake_in_progress" then "Intake In Progress"
  when "intake_review" then "Intake Review"
  when "planning_pending" then "Planning Pending"
  when "planning_in_progress" then "Planning In Progress"
  when "planning_review" then "Planning Review"
  when "execution_pending" then "Execution Pending"
  when "execution_in_progress" then "Execution In Progress"
  when "execution_review" then "Execution Review"
  when "completed" then "Completed"
  else status.humanize
  end
%>

<span class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium <%= badge_classes %>">
  <% if status.end_with?("_review") %>
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00b4d8] opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00b4d8]"></span>
    </span>
  <% elsif status.end_with?("_in_progress") %>
    <svg class="h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  <% elsif status == "completed" %>
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  <% end %>
  <%= label %>
</span>
