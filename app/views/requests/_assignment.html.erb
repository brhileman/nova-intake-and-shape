<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<div class="px-4 py-3 border-b border-slate-700">
  <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-3">Team</h3>
  
  <%# Team members list %>
  <div class="space-y-2">
    <%# PM %>
    <div class="flex items-center justify-between py-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-blue-900/50 text-blue-400">PM</span>
      </div>
      <% if req.project.pm %>
        <span class="text-sm text-slate-200"><%= req.project.pm.name %></span>
      <% else %>
        <span class="text-sm text-slate-500 italic">Unassigned</span>
      <% end %>
    </div>
    
    <%# Designer %>
    <div class="flex items-center justify-between py-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-purple-900/50 text-purple-400">DESIGNER</span>
      </div>
      <% if req.project.designer %>
        <span class="text-sm text-slate-200"><%= req.project.designer.name %></span>
      <% else %>
        <span class="text-sm text-slate-500 italic">Unassigned</span>
      <% end %>
    </div>
    
    <%# Dev %>
    <div class="flex items-center justify-between py-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-green-900/50 text-green-400">DEV</span>
      </div>
      <% if req.project.dev %>
        <span class="text-sm text-slate-200"><%= req.project.dev.name %></span>
      <% else %>
        <span class="text-sm text-slate-500 italic">Unassigned</span>
      <% end %>
    </div>
  </div>

  <%# Created by info %>
  <% if req.created_by %>
    <div class="mt-3 pt-3 border-t border-slate-700">
      <div class="flex items-center justify-between text-xs">
        <span class="text-slate-500">Created by</span>
        <span class="text-slate-300 font-medium"><%= req.created_by.name %></span>
      </div>
    </div>
  <% end %>
</div>
