<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
  <h3 class="text-sm font-medium text-slate-700 mb-3">Project Team</h3>
  
  <%# Team members list %>
  <div class="space-y-2">
    <%# PM %>
    <div class="flex items-center justify-between py-1.5">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-blue-100 text-blue-800">PM</span>
      </div>
      <% if req.project.pm %>
        <span class="text-sm text-slate-700"><%= req.project.pm.name %></span>
      <% else %>
        <span class="text-sm text-slate-400 italic">Unassigned</span>
      <% end %>
    </div>
    
    <%# Designer %>
    <div class="flex items-center justify-between py-1.5">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-purple-100 text-purple-800">DESIGNER</span>
      </div>
      <% if req.project.designer %>
        <span class="text-sm text-slate-700"><%= req.project.designer.name %></span>
      <% else %>
        <span class="text-sm text-slate-400 italic">Unassigned</span>
      <% end %>
    </div>
    
    <%# Dev %>
    <div class="flex items-center justify-between py-1.5">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">DEV</span>
      </div>
      <% if req.project.dev %>
        <span class="text-sm text-slate-700"><%= req.project.dev.name %></span>
      <% else %>
        <span class="text-sm text-slate-400 italic">Unassigned</span>
      <% end %>
    </div>
  </div>

  <%# Request-level override (collapsible) %>
  <details class="mt-3 pt-3 border-t border-slate-100">
    <summary class="text-xs font-medium text-slate-500 cursor-pointer hover:text-slate-700">
      Override for this request
    </summary>
    <div class="mt-2">
      <%= form_with url: assign_request_path(req), method: :patch, data: { turbo_stream: true } do |f| %>
        <div class="space-y-2">
          <%= f.select :assignee_id, 
              options_for_select(
                [["Use project team (default)", nil]] + all_users.map { |u| ["#{u.name} (#{u.role.upcase})", u.id] },
                req.assignee_id
              ),
              {},
              class: "w-full px-2 py-1.5 text-xs border border-slate-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" %>
          <%= f.submit "Update", class: "w-full px-2 py-1.5 text-xs font-medium text-white bg-slate-600 rounded-lg hover:bg-slate-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
      <% if req.assignee %>
        <p class="mt-2 text-xs text-amber-600">
          Override active: <%= req.assignee.name %> (<%= req.assignee.role.upcase %>)
        </p>
      <% end %>
    </div>
  </details>

  <%# Created by info %>
  <% if req.created_by %>
    <div class="mt-3 pt-3 border-t border-slate-100">
      <div class="flex items-center justify-between text-xs">
        <span class="text-slate-500">Created by</span>
        <span class="text-slate-700 font-medium"><%= req.created_by.name %></span>
      </div>
    </div>
  <% end %>
</div>
