<%# Request Details - Left sidebar with metadata and team %>
<% req = local_assigns[:request] || @request %>
<div class="flex flex-col h-full overflow-y-auto">
  <%# Breadcrumb navigation %>
  <div class="px-3 py-2 border-b border-slate-700">
    <nav class="flex items-center gap-1 text-xs text-slate-400">
      <%= link_to "Home", root_path, class: "hover:text-slate-200 transition-colors" %>
      <svg class="h-2.5 w-2.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <%= link_to req.project.name.truncate(12), project_path(req.project), class: "hover:text-slate-200 transition-colors" %>
      <svg class="h-2.5 w-2.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-slate-200">REQ-<%= req.request_number %></span>
    </nav>
  </div>
  
  <%# Request Title & Phase Header %>
  <%
    phases = [
      { name: "Planning", states: %w[intake_pending intake_in_progress intake_needs_clarification plan_ready] },
      { name: "Execution", states: %w[execution_pending execution_in_progress execution_review completed] }
    ]
    current_phase = phases.find { |p| p[:states].include?(req.status) }
    phase_name = current_phase ? current_phase[:name] : "Unknown"
  %>
  <div class="px-3 py-3 border-b border-slate-700">
    <div class="text-xs text-slate-500 mb-1">REQ-<%= req.request_number %></div>
    <h1 class="text-[24px] font-medium text-slate-100 leading-tight"><%= req.generated_title %></h1>
  </div>
  
  <%# Original Request Section %>
  <div class="px-3 py-3 border-b border-slate-700">
    <details class="group" open>
      <summary class="flex items-center justify-between cursor-pointer">
        <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider">Request</h3>
        <svg class="h-3 w-3 text-slate-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="mt-2 text-xs text-slate-300 leading-relaxed">
        <%= truncate(req.original_input, length: 200) %>
      </div>
    </details>
    
    <% if %w[fix chore].include?(req.request_type) && req.summary.present? %>
      <div class="mt-2 pt-2 border-t border-slate-700">
        <h4 class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-1">Summary</h4>
        <p class="text-xs text-slate-300"><%= truncate(req.summary, length: 100) %></p>
      </div>
    <% end %>
  </div>

  <%# Properties Section %>
  <div class="px-3 py-3 border-b border-slate-700">
    <%# Agent Working Indicator %>
    <% if req.status.end_with?("_in_progress") %>
      <div class="rounded bg-amber-900/30 border border-amber-700/50 p-2 mb-3">
        <div class="flex items-center gap-2">
          <svg class="h-3 w-3 text-amber-400 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="text-xs font-medium text-amber-400">Working...</span>
        </div>
      </div>
    <% end %>

    <div class="space-y-2.5">
      <%# Group %>
      <div class="flex items-center justify-between">
        <span class="text-xs text-slate-500">Group</span>
        <% if req.request_group.present? %>
          <span class="inline-flex items-center gap-1 text-xs text-purple-300">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <%= req.request_group.name.truncate(15) %>
          </span>
        <% else %>
          <span class="text-xs text-slate-500">None</span>
        <% end %>
      </div>

      <%# Type %>
      <div class="flex items-center justify-between">
        <span class="text-xs text-slate-500">Type</span>
        <% if req.request_type.present? %>
          <span class="text-xs text-slate-300">
            <%= req.request_type.humanize %>
          </span>
        <% else %>
          <span class="text-xs text-slate-500">Pending</span>
        <% end %>
      </div>

      <%# Priority (editable dropdown) %>
      <%= render "requests/priority_selector", request: req %>

      <%# Dependencies (editable) %>
      <%= render "requests/dependencies_input", request: req %>

      <%# Estimate %>
      <% if req.estimate_days.present? %>
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-500">Estimate</span>
          <span class="text-xs text-slate-200"><%= req.estimate_days %> days</span>
        </div>
      <% end %>

      <%# Created %>
      <div class="flex items-center justify-between">
        <span class="text-xs text-slate-500">Created</span>
        <span class="text-xs text-slate-200"><%= time_ago_in_words(req.created_at) %> ago</span>
      </div>
    </div>

    <%# Debug info in development %>
    <% if Rails.env.development? %>
      <div class="pt-2 mt-2 border-t border-slate-700">
        <p class="text-[10px] text-slate-500 font-mono">
          Status: <%= req.status %><br>
          <% if req.current_agent_id %>
            Agent: <%= req.current_agent_id.truncate(16) %>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>

  <%# Team Section %>
  <div class="px-3 py-3">
    <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Team</h3>
    <div class="space-y-2">
      <%# PM %>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wide">PM</span>
        <% if req.project.pm %>
          <span class="text-xs text-slate-300"><%= req.project.pm.name %></span>
        <% else %>
          <span class="text-xs text-slate-500 italic">Unassigned</span>
        <% end %>
      </div>
      
      <%# Designer %>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wide">Designer</span>
        <% if req.project.designer %>
          <span class="text-xs text-slate-300"><%= req.project.designer.name %></span>
        <% else %>
          <span class="text-xs text-slate-500 italic">Unassigned</span>
        <% end %>
      </div>
      
      <%# Dev %>
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wide">Dev</span>
        <% if req.project.dev %>
          <span class="text-xs text-slate-300"><%= req.project.dev.name %></span>
        <% else %>
          <span class="text-xs text-slate-500 italic">Unassigned</span>
        <% end %>
      </div>
    </div>

    <%# Created by info %>
    <% if req.created_by %>
      <div class="mt-3 pt-3 border-t border-slate-700">
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-500">Created by</span>
          <span class="text-slate-300"><%= req.created_by.name %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
