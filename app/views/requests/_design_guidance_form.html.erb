<%# Design guidance form with multiple Figma links %>
<% design_guidance = request.design_guidance || request.build_design_guidance %>
<% locked = request.in_execution_phase? %>

<div class="flex-1 flex flex-col h-full">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-white">Design Guidance</h2>
  </div>
  
  <%# Locked banner when in execution phase %>
  <% if locked %>
    <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="text-sm text-slate-400">Design guidance locked — Build has started</span>
    </div>
    
    <%# Read-only display when locked %>
    <div class="flex-1 flex flex-col space-y-6">
      <%# Specifications (read-only) %>
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Design Specifications</label>
        <div class="w-full px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg text-slate-300 text-sm min-h-[100px]">
          <% if design_guidance.specifications.present? %>
            <%= simple_format(design_guidance.specifications) %>
          <% else %>
            <span class="text-slate-500 italic">No specifications provided</span>
          <% end %>
        </div>
      </div>
      
      <%# Figma links (read-only) %>
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Figma Links</label>
        <% if design_guidance.figma_links.any? %>
          <div class="space-y-2">
            <% design_guidance.figma_links.each do |link| %>
              <div class="flex items-center gap-2 px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg">
                <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <a href="<%= link.url %>" target="_blank" class="text-cyan-400 hover:text-cyan-300 text-sm truncate"><%= link.url %></a>
                <% if link.description.present? %>
                  <span class="text-slate-500 text-sm">— <%= link.description %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg">
            <span class="text-slate-500 italic text-sm">No Figma links provided</span>
          </div>
        <% end %>
      </div>
      
      <%# Design images (read-only) %>
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Design Images</label>
        <% if design_guidance.images.attached? %>
          <div class="grid grid-cols-2 gap-2">
            <% design_guidance.images.each do |image| %>
              <div class="relative group">
                <%= image_tag url_for(image), class: "w-full h-32 object-cover rounded-lg border border-slate-700" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg">
            <span class="text-slate-500 italic text-sm">No design images uploaded</span>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
  
  <%= form_with model: [request, design_guidance], 
      url: design_guidance.persisted? ? request_design_guidance_path(request) : request_design_guidance_path(request),
      method: design_guidance.persisted? ? :patch : :post,
      local: true,
      class: "flex-1 flex flex-col space-y-6" do |f| %>
    
    <%# Specifications textarea %>
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Design Specifications</label>
      <%= f.text_area :specifications, 
          placeholder: "Enter design notes, constraints, or specifications...",
          rows: 4,
          class: "w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-slate-200 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
    </div>
    
    <%# Figma links section %>
    <div data-controller="figma-links">
      <label class="block text-sm font-medium text-slate-300 mb-2">Figma Links</label>
      
      <div data-figma-links-target="container" class="space-y-3">
        <% if design_guidance.figma_links.any? %>
          <% design_guidance.figma_links.each_with_index do |link, index| %>
            <div data-figma-links-target="row" class="flex gap-2 items-start bg-slate-800 p-3 rounded-lg">
              <%= f.fields_for :figma_links, link, index: index do |fl| %>
                <%= fl.hidden_field :id %>
                <%= fl.hidden_field :position, value: index %>
                <div class="flex-1 space-y-2">
                  <%= fl.text_field :url, 
                      placeholder: "https://figma.com/...",
                      class: "w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
                  <%= fl.text_field :description, 
                      placeholder: "Description (e.g., 'Main dashboard wireframe')",
                      class: "w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
                </div>
                <button type="button" 
                        data-action="figma-links#remove"
                        class="p-2 text-slate-400 hover:text-red-400 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      
      <%# Template for new rows (hidden) %>
      <template data-figma-links-target="template">
        <div data-figma-links-target="row" class="flex gap-2 items-start bg-slate-800 p-3 rounded-lg">
          <div class="flex-1 space-y-2">
            <input type="text" 
                   name="design_guidance[figma_links_attributes][NEW_INDEX][url]" 
                   placeholder="https://figma.com/..."
                   class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
            <input type="text" 
                   name="design_guidance[figma_links_attributes][NEW_INDEX][description]" 
                   placeholder="Description (e.g., 'Main dashboard wireframe')"
                   class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
            <input type="hidden" name="design_guidance[figma_links_attributes][NEW_INDEX][position]" value="NEW_INDEX">
          </div>
          <button type="button" 
                  data-action="figma-links#remove"
                  class="p-2 text-slate-400 hover:text-red-400 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      </template>
      
      <button type="button" 
              data-action="figma-links#add"
              class="mt-3 flex items-center gap-2 text-sm text-cyan-400 hover:text-cyan-300 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Figma link
      </button>
    </div>
    
    <%# Design images %>
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Design Images</label>
      
      <% if design_guidance.images.attached? %>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <% design_guidance.images.each do |image| %>
            <div class="relative group">
              <%= image_tag url_for(image), class: "w-full h-32 object-cover rounded-lg" %>
            </div>
          <% end %>
        </div>
      <% end %>
      
      <%= f.file_field :images, 
          multiple: true,
          accept: "image/*",
          class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-slate-700 file:text-slate-200 hover:file:bg-slate-600 file:cursor-pointer" %>
      <p class="mt-1 text-xs text-slate-500">Upload mockups, wireframes, or design references</p>
    </div>
    
    <%# Submit button %>
    <div class="pt-4">
      <%= f.submit "Save Design Guidance",
          class: "w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md font-medium text-sm transition-colors cursor-pointer" %>
    </div>
  <% end %>
  <% end %>
</div>
