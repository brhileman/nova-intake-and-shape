<% compact = local_assigns[:compact] || false %>
<% if compact %>
  <details class="rounded-lg border border-slate-200 bg-slate-50 group">
    <summary class="flex items-center justify-between p-2.5 cursor-pointer hover:bg-slate-100 rounded-lg">
      <div class="flex items-center gap-2">
        <div class="flex h-6 w-6 items-center justify-center rounded bg-emerald-100">
          <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <span class="text-xs font-medium text-slate-700">Brief</span>
      </div>
      <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="px-2.5 pb-2.5">
      <div class="prose prose-sm max-w-none text-slate-600 text-xs bg-white rounded p-2 max-h-40 overflow-y-auto">
        <%= render_markdown(brief.content) %>
      </div>
    </div>
  </details>
<% else %>
  <details class="bg-white rounded-lg border border-slate-200 shadow-sm group" open>
    <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50 rounded-t-lg">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100">
          <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Brief</h3>
          <p class="text-xs text-slate-500">From Intake Phase</p>
        </div>
      </div>
      <svg class="h-5 w-5 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="px-4 pb-4">
      <div class="prose prose-sm max-w-none text-slate-700 bg-slate-50 rounded-lg p-4">
        <%= render_markdown(brief.content) %>
      </div>
    </div>
  </details>
<% end %>
