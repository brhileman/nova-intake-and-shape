<%# Signal to layout that this view needs full-width IDE layout %>
<% content_for :full_width, true %>

<%# Hidden element for polling controller to detect status changes - scoped to request %>
<div id="request_status_value_<%= @request.id %>" data-status="<%= @request.status %>" class="hidden"></div>

<div class="flex h-screen"
     id="polling-container-<%= @request.id %>"
     data-controller="polling"
     data-polling-url-value="<%= poll_request_path(@request) %>"
     data-polling-request-id-value="<%= @request.id %>"
     data-polling-interval-value="10000">
  
  <%# Left Column - Request Details (metadata & team) %>
  <div class="w-[226px] border-r border-slate-700 bg-slate-800 flex-shrink-0">
    <%= render "project_selector", request: @request %>
  </div>
  
  <%# Middle Column - Properties Panel (increased width by 75px) %>
  <div class="w-[385px] border-r border-slate-700 bg-slate-800 flex-shrink-0 overflow-y-auto">
    <%= render "properties_panel", request: @request %>
  </div>
  
  <%# Right Column - Agent Chat (main area) %>
  <div class="flex-1 flex flex-col bg-slate-900 min-w-0">
    <div id="chat_thread_<%= @request.id %>" class="flex-1 flex flex-col min-h-0">
      <%= render "chat_thread", request: @request, conversation: @conversation %>
    </div>
  </div>
</div>
