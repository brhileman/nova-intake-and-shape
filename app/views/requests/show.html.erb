<div class="mb-6">
  <%= link_to requests_path, class: "inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Requests
  <% end %>
</div>

<%# Phase Stepper - wrapped in div for Turbo Stream replacement %>
<div id="phase_stepper_<%= @request.id %>">
  <%= render "phase_stepper", request: @request %>
</div>

<%# Hidden element for polling controller to detect status changes - scoped to request %>
<div id="request_status_value_<%= @request.id %>" data-status="<%= @request.status %>" class="hidden"></div>

<%# Project Overview - Structured data at the top %>
<div class="mt-6" id="project_overview_<%= @request.id %>">
  <%= render "project_overview", request: @request %>
</div>

<div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6"
     id="polling-container-<%= @request.id %>"
     data-controller="polling"
     data-polling-url-value="<%= poll_request_path(@request) %>"
     data-polling-request-id-value="<%= @request.id %>"
     data-polling-interval-value="10000">
  
  <%# Left Column - Artifacts %>
  <div class="lg:col-span-1 space-y-4">
    <div id="artifacts_<%= @request.id %>">
      <%= render "artifacts_stack", request: @request %>
    </div>
    
    <%# Sidebar - Status and Actions (moved below artifacts on desktop) %>
    <div id="agent_status_<%= @request.id %>">
      <%= render "agent_status", request: @request %>
    </div>
  </div>

  <%# Right Column - Conversation Area %>
  <div class="lg:col-span-2">
    <div id="chat_thread_<%= @request.id %>">
      <%= render "chat_thread", request: @request, conversation: @conversation %>
    </div>
  </div>
</div>
