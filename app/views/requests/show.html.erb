<%# Signal to layout that this view needs full-width IDE layout %>
<% content_for :full_width, true %>

<%# Hidden element for polling controller to detect status changes - scoped to request %>
<div id="request_status_value_<%= @request.id %>" data-status="<%= @request.status %>" class="hidden"></div>

<div class="flex h-screen"
     id="polling-container-<%= @request.id %>"
     data-controller="polling"
     data-polling-url-value="<%= poll_request_path(@request) %>"
     data-polling-request-id-value="<%= @request.id %>"
     data-polling-interval-value="10000">
  
  <%# Column 1: Breadcrumb + Request List %>
  <div class="w-[200px] border-r border-slate-700 bg-slate-800 flex-shrink-0 flex flex-col">
    <%# Breadcrumb at top %>
    <%= render "breadcrumb", request: @request %>
    
    <%# Request list below (scrollable) %>
    <div class="flex-1 overflow-y-auto">
      <%= render "request_list", project: @request.project, current_request: @request %>
    </div>
  </div>
  
  <%# Column 2: Metadata + Actions %>
  <div class="w-[280px] border-r border-slate-700 bg-slate-800 flex-shrink-0 overflow-y-auto">
    <%= render "metadata_panel", request: @request, active_panel: @active_panel %>
  </div>
  
  <%# Column 3: Contextual Content Panel %>
  <div class="flex-1 flex flex-col bg-slate-900 min-w-0">
    <div id="content_panel_<%= @request.id %>" class="flex-1 flex flex-col min-h-0 overflow-y-auto">
      <%= render "content_panel", request: @request, active_panel: @active_panel %>
    </div>
  </div>
</div>
