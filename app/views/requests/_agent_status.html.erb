<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 space-y-4">
  <%# Agent Working Indicator %>
  <% if req.status.end_with?("_in_progress") %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 p-3">
      <div class="flex items-center gap-2">
        <div class="flex-shrink-0">
          <svg class="h-4 w-4 text-amber-500 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-amber-800">Agent working...</p>
        </div>
      </div>
    </div>
    <%# Check status button %>
    <%= link_to poll_request_path(req), 
        data: { turbo_stream: true },
        class: "w-full rounded-lg bg-slate-100 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition-colors flex items-center justify-center gap-2" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      Check Status
    <% end %>
  <% end %>

  <%# Properties list - Linear style %>
  <div class="space-y-3">
    <%# Assignee %>
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Assignee</span>
      <div class="flex items-center gap-2">
        <div class="h-5 w-5 rounded-full bg-slate-200 flex items-center justify-center">
          <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <span class="text-sm text-slate-700">Nova Agent</span>
      </div>
    </div>

    <%# Type %>
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Type</span>
      <% if req.request_type.present? %>
        <% badge_color = case req.request_type
                         when "new_feature" then "bg-emerald-100 text-emerald-700"
                         when "update" then "bg-blue-100 text-blue-700"
                         when "fix" then "bg-red-100 text-red-700"
                         else "bg-slate-100 text-slate-700"
                         end %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= badge_color %>">
          <%= req.request_type.humanize %>
        </span>
      <% else %>
        <span class="text-sm text-slate-400">Pending</span>
      <% end %>
    </div>

    <%# Estimate %>
    <% if req.estimate_days.present? %>
      <div class="flex items-center justify-between">
        <span class="text-sm text-slate-500">Estimate</span>
        <span class="text-sm text-slate-700"><%= req.estimate_days %> days</span>
      </div>
    <% end %>

    <%# Created %>
    <div class="flex items-center justify-between">
      <span class="text-sm text-slate-500">Created</span>
      <span class="text-sm text-slate-700"><%= time_ago_in_words(req.created_at) %> ago</span>
    </div>
  </div>

  <%# Debug info in development %>
  <% if Rails.env.development? %>
    <div class="pt-3 border-t border-slate-200">
      <p class="text-xs text-slate-400 font-mono">
        Status: <%= req.status %><br>
        <% if req.current_agent_id %>
          Agent: <%= req.current_agent_id.truncate(16) %>
        <% end %>
      </p>
    </div>
  <% end %>
</div>
