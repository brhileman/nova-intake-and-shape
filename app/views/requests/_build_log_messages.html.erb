<%# Build log messages content - used for Turbo Stream updates %>
<% messages = conversation || [] %>

<% if request.plan_ready? %>
  <%# Build not started yet %>
  <div class="flex flex-col items-center justify-center h-full text-center py-12">
    <svg class="w-12 h-12 text-slate-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-slate-400 text-sm">Build not started yet</p>
    <p class="text-slate-500 text-xs mt-1">Click the Build button to start the execution agent</p>
  </div>
<% elsif messages.empty? %>
  <%# Build started but no messages yet %>
  <div class="flex flex-col items-center justify-center h-full text-center py-12">
    <svg class="w-12 h-12 text-amber-500 animate-spin mb-4" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-slate-400 text-sm">Agent is starting...</p>
    <p class="text-slate-500 text-xs mt-1">Messages will appear here as the agent works</p>
  </div>
<% else %>
  <%# Render messages %>
  <% messages.each do |message| %>
    <%= render "message", message: message %>
  <% end %>
  
  <%# Completed banner %>
  <% if request.completed? %>
    <div class="bg-emerald-900/30 border border-emerald-700/50 rounded-lg p-4 mt-4">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm font-medium text-emerald-400">Build completed successfully</p>
      </div>
      <% if request.execution&.pr_url.present? %>
        <p class="text-sm text-emerald-300/70 mt-1">
          Pull request created and ready for review.
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
