<%# Navigation breadcrumb at top of left column %>
<div class="px-3 py-3 border-b border-slate-700">
  <nav class="text-xs text-slate-400">
    <%= link_to root_path, class: "hover:text-white transition-colors" do %>
      <svg class="w-3.5 h-3.5 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    <% end %>
    <span class="mx-1">/</span>
    <%= link_to request.project.name, project_path(request.project), 
        class: "hover:text-white transition-colors truncate inline-block max-w-[140px] align-bottom",
        title: request.project.name %>
  </nav>
</div>
