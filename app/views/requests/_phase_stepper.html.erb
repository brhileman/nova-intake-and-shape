<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<%
  phases = [
    { name: "Intake", states: %w[intake_pending intake_in_progress intake_needs_clarification intake_clarified] },
    { name: "Planning", states: %w[planning_pending planning_in_progress planning_needs_clarification planning_clarified] },
    { name: "Execution", states: %w[execution_pending execution_in_progress execution_review completed] }
  ]
  
  current_phase_index = phases.find_index { |p| p[:states].include?(req.status) } || 0
%>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
  <%# Compact status header %>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-medium text-slate-700">Status</h3>
    <%= render "status_badge", status: req.status %>
  </div>

  <%# Vertical phase list - compact for sidebar %>
  <nav aria-label="Progress">
    <ol class="space-y-2">
      <% phases.each_with_index do |phase, index| %>
        <%
          is_complete = index < current_phase_index || req.status == "completed"
          is_current = index == current_phase_index && req.status != "completed"
          is_future = index > current_phase_index
        %>
        <li class="flex items-center gap-3">
          <%# Circle/Icon %>
          <div class="relative flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full 
                      <%= is_complete ? 'bg-emerald-500' : is_current ? 'bg-[#00b4d8]' : 'bg-slate-200' %>">
            <% if is_complete %>
              <svg class="h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            <% elsif is_current %>
              <span class="h-2 w-2 rounded-full bg-white"></span>
            <% else %>
              <span class="h-2 w-2 rounded-full bg-slate-400"></span>
            <% end %>
          </div>
          
          <%# Label %>
          <span class="text-sm <%= is_current ? 'font-medium text-[#00b4d8]' : is_complete ? 'text-emerald-600' : 'text-slate-500' %>">
            <%= phase[:name] %>
          </span>
        </li>
      <% end %>
    </ol>
  </nav>
</div>
