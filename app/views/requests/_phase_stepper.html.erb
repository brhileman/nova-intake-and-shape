<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<%
  phases = [
    { name: "Planning", states: %w[intake_pending intake_in_progress intake_needs_clarification plan_ready] },
    { name: "Execution", states: %w[execution_pending execution_in_progress execution_review completed] }
  ]
  
  current_phase_index = phases.find_index { |p| p[:states].include?(req.status) } || 0
%>

<div class="px-4 py-3 border-b border-slate-700">
  <%# Section header %>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider">Status</h3>
    <%= render "status_badge", status: req.status %>
  </div>

  <%# Horizontal phase stepper %>
  <nav aria-label="Progress">
    <ol class="flex items-start justify-between">
      <% phases.each_with_index do |phase, index| %>
        <%
          is_complete = index < current_phase_index || req.status == "completed"
          is_current = index == current_phase_index && req.status != "completed"
          is_future = index > current_phase_index
        %>
        <li class="flex flex-col items-center flex-1 relative">
          <%# Connecting line (except for last item) %>
          <% unless index == phases.length - 1 %>
            <div class="absolute top-2.5 left-1/2 w-full h-0.5 <%= is_complete ? 'bg-emerald-500' : 'bg-slate-600' %>"></div>
          <% end %>
          
          <%# Circle/Icon %>
          <div class="relative z-10 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full 
                      <%= is_complete ? 'bg-emerald-500' : is_current ? 'bg-cyan-500' : 'bg-slate-600' %>">
            <% if is_complete %>
              <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            <% elsif is_current %>
              <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
            <% else %>
              <span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span>
            <% end %>
          </div>
          
          <%# Label %>
          <span class="mt-1.5 text-xs text-center <%= is_current ? 'font-medium text-cyan-400' : is_complete ? 'text-emerald-400' : 'text-slate-500' %>">
            <%= phase[:name] %>
          </span>
        </li>
      <% end %>
    </ol>
  </nav>
</div>
