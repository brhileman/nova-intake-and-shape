<%# Local: request (Request model), conversation (Array of messages) %>
<% req = local_assigns[:request] || @request %>
<% conv = local_assigns[:conversation] || @conversation || [] %>
<div class="bg-white rounded-lg border border-slate-200 shadow-sm" data-controller="chat">
  <%# Header %>
  <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200">
    <div class="flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <h3 class="text-sm font-semibold text-slate-900">
        <%= req.current_phase.capitalize %> Conversation
      </h3>
    </div>
  </div>

  <%# Messages %>
  <div class="h-96 overflow-y-auto p-4 space-y-4" data-chat-target="messages">
    <% if conv.empty? %>
      <div class="flex items-center justify-center h-full">
        <div class="text-center">
          <svg class="mx-auto h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <p class="mt-2 text-sm text-slate-500">No messages yet</p>
          <p class="text-xs text-slate-400">Waiting for agent response...</p>
        </div>
      </div>
    <% else %>
      <% conv.each do |message| %>
        <%= render "message", message: message %>
      <% end %>
    <% end %>
  </div>

  <%# Message Input %>
  <% unless req.status == "completed" %>
    <div class="px-4 py-3 border-t border-slate-200">
      <%= form_with url: comment_request_path(req), 
                    method: :post, 
                    class: "flex items-end gap-3",
                    data: { controller: "form", action: "turbo:submit-start->form#disable turbo:submit-end->form#enable" } do |f| %>
        <div class="flex-1">
          <%= f.text_area :message, 
              rows: 2,
              placeholder: "Type your message...",
              class: "block w-full rounded-lg border-slate-300 shadow-sm focus:border-[#00b4d8] focus:ring-[#00b4d8] text-sm resize-none",
              data: { chat_target: "input", action: "keydown.enter->chat#submitOnEnter" } %>
        </div>
        <%= f.submit "Send", 
            class: "rounded-lg bg-[#00b4d8] px-4 py-2 text-sm font-semibold text-white hover:bg-[#0096b4] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed",
            data: { form_target: "submit" } %>
      <% end %>
    </div>
  <% end %>
</div>
