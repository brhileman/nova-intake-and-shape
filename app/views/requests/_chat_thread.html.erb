<%# Local: request (Request model), conversation (Array of messages) %>
<% req = local_assigns[:request] || @request %>
<% conv = local_assigns[:conversation] || @conversation || [] %>
<div class="flex flex-col h-full" data-controller="chat">
  <%# Messages - scrollable area %>
  <div class="flex-1 overflow-y-auto p-5 space-y-4" data-chat-target="messages">
    <% if conv.empty? %>
      <div class="flex items-center justify-center h-full">
        <div class="text-center" data-controller="loading-text">
          <svg class="mx-auto h-10 w-10 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <p class="mt-3 text-sm text-slate-400">No messages yet</p>
          <p class="text-xs text-slate-500 min-w-[200px]" data-loading-text-target="text">Waiting for agent response...</p>
        </div>
      </div>
    <% else %>
      <% conv.each do |message| %>
        <%= render "message", message: message %>
      <% end %>
    <% end %>
  </div>

  <%# Bottom section - Action CTA and/or Message Input %>
  <div class="border-t border-slate-700 bg-slate-900">
    <% if req.status == "completed" %>
      <div class="px-5 py-3 bg-emerald-900/30">
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm font-medium text-emerald-400">Request completed</p>
        </div>
      </div>
    <% end %>

    <%# Message Input - shown unless completed %>
    <% unless req.status == "completed" %>
      <div class="px-4 py-3">
        <%= form_with url: comment_request_path(req), 
                      method: :post, 
                      class: "flex items-center gap-3",
                      data: { turbo_stream: true, controller: "form", action: "turbo:submit-start->form#disable turbo:submit-end->form#enable" } do |f| %>
          <div class="flex-1 relative">
            <%= f.text_area :message, 
                placeholder: "Send message to agent...",
                rows: 2,
                class: "w-full px-3 py-2 text-sm border border-slate-600 rounded-lg bg-slate-900 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 resize-none",
                data: { chat_target: "input" } %>
          </div>
          <%= f.submit "Send", 
              class: "px-4 py-2 text-sm font-medium text-white bg-cyan-600 rounded-lg hover:bg-cyan-500 transition-colors cursor-pointer disabled:opacity-50",
              data: { form_target: "submit" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
