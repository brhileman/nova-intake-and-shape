<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<div class="px-4 py-3 border-b border-slate-700">
  <%# Header with Original Request collapsible %>
  <details class="group">
    <summary class="flex items-center justify-between cursor-pointer">
      <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider">Original Request</h3>
      <svg class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="mt-3 p-3 bg-slate-900 rounded-lg text-sm text-slate-300 whitespace-pre-wrap border border-slate-700">
      <%= req.original_input %>
    </div>
  </details>

  <%# Bug Summary - for fix requests %>
  <% if req.request_type == "fix" && req.bug_summary.present? %>
    <div class="mt-4 pt-4 border-t border-slate-700">
      <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">Bug Summary</h3>
      <p class="text-sm text-slate-300"><%= req.bug_summary %></p>
    </div>
  <% end %>
</div>
