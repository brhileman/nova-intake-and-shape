<%# Local: request (Request model) %>
<% req = local_assigns[:request] || @request %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
  <%# Header with Original Request collapsible %>
  <details class="group">
    <summary class="flex items-center justify-between cursor-pointer">
      <h3 class="text-sm font-medium text-slate-700">Original Request</h3>
      <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="mt-3 p-3 bg-slate-50 rounded-lg text-sm text-slate-700 whitespace-pre-wrap">
      <%= req.original_input %>
    </div>
  </details>

  <%# User Story - shown if available %>
  <% if req.request_type.blank? || req.request_type != "fix" %>
    <% if req.user_story_action.present? %>
      <div class="mt-4 pt-4 border-t border-slate-100">
        <h3 class="text-sm font-medium text-slate-700 mb-2">User Story</h3>
        <div class="bg-slate-50 rounded-lg px-3 py-2 text-sm space-y-0.5">
          <p><span class="text-slate-500">As a</span> <%= req.user_story_persona %></p>
          <p><span class="text-slate-500">I want</span> <%= req.user_story_action %></p>
          <p><span class="text-slate-500">So that</span> <%= req.user_story_outcome %></p>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Bug Summary - for fix requests %>
  <% if req.request_type == "fix" && req.bug_summary.present? %>
    <div class="mt-4 pt-4 border-t border-slate-100">
      <h3 class="text-sm font-medium text-slate-700 mb-2">Bug Summary</h3>
      <p class="text-sm text-slate-600"><%= req.bug_summary %></p>
    </div>
  <% end %>

  <%# PR Link %>
  <% if req.execution&.pr_url.present? %>
    <div class="mt-4 pt-4 border-t border-slate-100">
      <h3 class="text-sm font-medium text-slate-700 mb-2">Pull Request</h3>
      <%= link_to req.execution.pr_url, 
          target: "_blank", 
          class: "text-blue-600 hover:underline flex items-center gap-1 text-sm" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        View on GitHub
      <% end %>
    </div>
  <% end %>
</div>
