<% compact = local_assigns[:compact] || false %>
<% if compact %>
  <details class="rounded-lg border border-slate-200 bg-slate-50 group">
    <summary class="flex items-center justify-between p-2.5 cursor-pointer hover:bg-slate-100 rounded-lg">
      <div class="flex items-center gap-2">
        <div class="flex h-6 w-6 items-center justify-center rounded bg-blue-100">
          <svg class="h-3.5 w-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <span class="text-xs font-medium text-slate-700">Plan</span>
        <% if request.requires_design_input? %>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Design</span>
        <% end %>
      </div>
      <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="px-2.5 pb-2.5">
      <div class="prose prose-sm max-w-none text-slate-600 text-xs bg-white rounded p-2 max-h-40 overflow-y-auto">
        <%= render_markdown(plan.content) %>
      </div>
    </div>
  </details>
<% else %>
  <details class="bg-white rounded-lg border border-slate-200 shadow-sm group" open>
    <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50 rounded-t-lg">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100">
          <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Plan</h3>
          <p class="text-xs text-slate-500">From Planning Phase</p>
        </div>
      </div>
      <svg class="h-5 w-5 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="px-4 pb-4">
      <%# Design input flag banner %>
      <% if request.requires_design_input? %>
        <div class="mb-4 rounded-lg bg-amber-50 border border-amber-200 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-semibold text-amber-800">Design Input Needed</h3>
              <p class="mt-1 text-sm text-amber-700">This plan requires design review before execution.</p>
            </div>
          </div>
        </div>
      <% end %>
      
      <div class="prose prose-sm max-w-none text-slate-700 bg-slate-50 rounded-lg p-4">
        <%= render_markdown(plan.content) %>
      </div>
    </div>
  </details>
<% end %>
