<%# 
  Artifact button with status indicator that opens a modal
  Locals: artifact_type ("plan"), status (:not_started, :drafted, :approved), artifact (Plan or nil), request
%>
<%
  artifact_type = local_assigns[:artifact_type] || "plan"
  status = local_assigns[:status] || :not_started
  artifact = local_assigns[:artifact]
  req = local_assigns[:request] || @request

  # Status styling - dark mode (subtle variant)
  status_config = case status
  when :not_started
    { 
      label: "Not Started", 
      bg: "bg-slate-800/50", 
      text: "text-slate-500",
      border: "border-slate-700/50",
      icon_bg: "bg-slate-800",
      icon_color: "text-slate-500",
      dot_color: "bg-slate-500"
    }
  when :drafted
    { 
      label: "Drafted", 
      bg: "bg-slate-800/50", 
      text: "text-amber-500/80",
      border: "border-slate-700/50",
      icon_bg: "bg-slate-800",
      icon_color: "text-slate-400",
      dot_color: "bg-amber-500/70"
    }
  when :approved
    { 
      label: "Approved", 
      bg: "bg-slate-800/50", 
      text: "text-emerald-500/80",
      border: "border-slate-700/50",
      icon_bg: "bg-slate-800",
      icon_color: "text-slate-400",
      dot_color: "bg-emerald-500/70"
    }
  end

  # Artifact type config - only plan now
  type_config = {
    title: "Plan",
    subtitle: "Implementation plan",
    icon_path: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
  }

  modal_id = "#{artifact_type}_modal_#{req.id}"
  is_clickable = artifact.present?
  
  # Determine pending approvals for the button indicator
  pending_approvals = []
  if status == :drafted
    required_roles = [["PM", :pm], ["Dev", :dev]]
    approval_status = req.plan_approval_status
    
    # Only show pending approvals when in plan_ready state
    if req.status == "plan_ready"
      required_roles.each do |role_label, role_key|
        pending_approvals << role_label unless approval_status[role_key]
      end
    end
  end
%>

<div data-controller="modal">
  <%# Button %>
  <% if is_clickable %>
    <button type="button"
            data-action="click->modal#open"
            class="w-full rounded-lg border <%= status_config[:border] %> <%= status_config[:bg] %> p-3 text-left transition-all hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 group">
  <% else %>
    <div class="w-full rounded-lg border border-dashed border-slate-600 p-3 opacity-60">
  <% end %>
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%# Icon %>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg <%= status_config[:icon_bg] %>">
          <svg class="h-4 w-4 <%= status_config[:icon_color] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= type_config[:icon_path] %>" />
          </svg>
        </div>
        <%# Title & Status %>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-sm font-medium text-slate-100"><%= type_config[:title] %></h4>
            <%# Status badge %>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium <%= status_config[:bg] %> <%= status_config[:text] %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_config[:dot_color] %>"></span>
              <%= status_config[:label] %>
            </span>
          </div>
          <p class="text-xs text-slate-500"><%= type_config[:subtitle] %></p>
          <% if pending_approvals.any? %>
            <p class="text-xs text-slate-500 mt-0.5">
              Pending Approvals: 
              <% pending_approvals.each_with_index do |role, idx| %>
                <span class="text-amber-400/80 font-medium"><%= role %></span><%= ", " unless idx == pending_approvals.length - 1 %>
              <% end %>
            </p>
          <% end %>
        </div>
      </div>
      <%# Arrow indicator (only if clickable) %>
      <% if is_clickable %>
        <svg class="h-4 w-4 text-slate-500 group-hover:text-slate-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  <% if is_clickable %>
    </button>
  <% else %>
    </div>
  <% end %>

  <%# Modal (only render if artifact exists) %>
  <% if artifact %>
    <dialog id="<%= modal_id %>" 
            data-modal-target="dialog"
            data-action="click->modal#backdropClick"
            class="fixed z-50 w-full max-w-2xl p-0 rounded-xl shadow-2xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm m-auto bg-slate-800 border border-slate-700">
      <div class="flex flex-col max-h-[85vh]">
        <%# Modal Header %>
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700 rounded-t-xl">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg <%= status_config[:icon_bg] %>">
              <svg class="h-5 w-5 <%= status_config[:icon_color] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= type_config[:icon_path] %>" />
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-semibold text-slate-100"><%= type_config[:title] %></h2>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium <%= status_config[:bg] %> <%= status_config[:text] %>">
                  <span class="h-1.5 w-1.5 rounded-full <%= status_config[:dot_color] %>"></span>
                  <%= status_config[:label] %>
                </span>
                <% if req.requires_design_input? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-900/50 text-amber-400">
                    Design Input Needed
                  </span>
                <% end %>
              </div>
            </div>
          </div>
          <button type="button"
                  data-action="click->modal#close"
                  class="rounded-lg p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-700 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%# Modal Body %>
        <div class="flex-1 overflow-y-auto p-6 bg-slate-800">
          <% if req.requires_design_input? %>
            <div class="mb-4 rounded-lg bg-amber-900/30 border border-amber-700/50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-semibold text-amber-400">Design Input Needed</h3>
                  <p class="mt-1 text-sm text-amber-500">This plan requires design review before execution.</p>
                </div>
              </div>
            </div>
          <% end %>
          <div class="prose prose-sm prose-invert max-w-none text-slate-300 bg-slate-900 rounded-lg p-6 border border-slate-700">
            <%= render_markdown(artifact.content) %>
          </div>
        </div>

        <%# Modal Footer %>
        <div class="px-6 py-4 border-t border-slate-700 rounded-b-xl">
          <%# Approval UI - shown when plan is drafted and awaiting approval %>
          <% show_approval = status == :drafted && req.status == "plan_ready" %>
          <% if show_approval %>
            <%
              required_roles = [["PM", :pm], ["Dev", :dev]]
              approval_status = req.plan_approval_status
              can_approve = req.can_user_approve?(current_user)
              
              # Determine if this approval will be the final one that triggers the agent
              existing_approvals = approval_status.values.compact.count
              required_count = required_roles.count
              is_final_approval = can_approve && (existing_approvals == required_count - 1)
              
              if is_final_approval
                cta_text = "Approve, start agent execution"
                cta_helper = "This approval will start the execution phase"
              else
                cta_text = "Approve Plan"
                cta_helper = "Requires both PM and Dev approval"
              end
            %>
            
            <div class="space-y-3">
              <%# Approval status row %>
              <div class="flex items-center gap-4">
                <p class="text-sm font-medium text-slate-300">Approvals Required:</p>
                <div class="flex items-center gap-3">
                  <% required_roles.each do |role_label, role_key| %>
                    <% approval = approval_status[role_key] %>
                    <div class="flex items-center gap-1.5">
                      <% if approval %>
                        <%# Approved - green check %>
                        <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-xs text-emerald-400 font-medium"><%= role_label %></span>
                        <span class="text-xs text-slate-500">(<%= approval.user.name %>)</span>
                      <% else %>
                        <%# Pending - gray circle %>
                        <svg class="h-4 w-4 text-slate-600" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm0-2a6 6 0 100-12 6 6 0 000 12z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-xs text-slate-400"><%= role_label %></span>
                        <span class="text-xs text-slate-500">(pending)</span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <%# Action row %>
              <div class="flex items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <% if can_approve %>
                    <p class="text-xs text-slate-400"><%= cta_helper %></p>
                  <% elsif current_user %>
                    <% phase = req.current_approval_phase %>
                    <% if req.user_has_approved_phase?(current_user, phase) %>
                      <p class="text-xs text-emerald-400">You have already approved this <%= phase %>.</p>
                    <% else %>
                      <p class="text-xs text-amber-400">Your role (<%= current_user.role.upcase %>) cannot approve this phase.</p>
                    <% end %>
                  <% end %>
                </div>
                <% if can_approve %>
                  <%= button_to approve_request_path(req), 
                      method: :post,
                      data: { turbo_stream: true },
                      class: "shrink-0 rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition-colors inline-flex items-center gap-1.5" do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <%= cta_text %>
                  <% end %>
                <% else %>
                  <div class="shrink-0 rounded-md bg-slate-700 px-4 py-2 text-sm font-medium text-slate-500 inline-flex items-center gap-1.5 cursor-not-allowed">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <%= cta_text %>
                  </div>
                <% end %>
              </div>
            </div>
          <% else %>
            <%# Standard close button when not in approval state %>
            <div class="flex items-center justify-end gap-3">
              <button type="button"
                      data-action="click->modal#close"
                      class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 border border-slate-600 rounded-lg hover:bg-slate-600 transition-colors">
                Close
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
